---
import Layout from '../layouts/MainLayout.astro';
import Navbar from '../components/shared/Navbar.astro';
import Hero from '../sections/Hero.astro';
import FeatureCards from '../sections/FeatureCards.astro';
import WhyUs from '../sections/WhyUs.astro';
import Stats from '../sections/Stats.astro';
import ProductsGrid from '../sections/ProductsGrid.astro';
import Clientes from '../sections/Clientes.astro';
// Se eliminó la importación de Contact para limpiar el Inicio
import Footer from '../components/shared/Footer.astro';
---

<Layout 
  title="Synapse Engineering | Diseño y Fabricación de Tableros Eléctricos"
  description="Líderes en ingeniería eléctrica, tableros de distribución y automatización industrial en Perú."
>
  <Navbar />
  <main>
    <Hero />
    <FeatureCards />
    <WhyUs />
    <Stats />
    
    <section class="bg-white">
      <ProductsGrid />
      
      <div class="pb-8 text-center -mt-16 relative z-10">
        <a href="/productos" class="inline-flex items-center gap-3 bg-[#005596] text-white px-10 py-4 rounded-full font-black uppercase text-xs tracking-[0.2em] shadow-xl hover:bg-blue-700 transition-all border-2 border-transparent">
          Ver todos los productos
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
        </a>
      </div>
    </section>
    
    <Clientes />

    <section class="py-24 flex justify-center text-center border-t border-slate-100 bg-white">
      <div class="max-w-3xl px-6">
        <h4 class="text-3xl md:text-5xl font-black text-slate-900 uppercase tracking-tighter mb-8 leading-none">
          ¿Tienes un proyecto de <span class="text-blue-600">Automatización?</span>
        </h4>
        <p class="text-slate-500 mb-10 font-medium text-lg">Nuestro equipo técnico está listo para asesorarte en el diseño y fabricación de tu próxima solución eléctrica.</p>
        <a href="/contacto" class="bg-blue-600 text-white px-12 py-5 rounded-full font-black uppercase text-xs tracking-[0.2em] shadow-xl hover:bg-blue-700 transition-all inline-block">
          Solicitar Cotización Inmediata
        </a>
      </div>
    </section>

    </main>
  <Footer />
</Layout>

<style is:global>
  /** * SOLUCIÓN DEFINITIVA ANTISALTOS 
   **/
  
  /* 1. Bloqueo de scrollbar y layout shift */
  html {
    overflow-y: scroll; 
    overflow-x: hidden;
    scroll-behavior: auto !important;
  }

  body {
    margin: 0;
    padding: 0;
    width: 100%;
    overflow-x: hidden;
    position: relative;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeSpeed;
  }

  /* 2. Anulación total de animaciones (Cero Olas) */
  .reveal, .reveal.active, [class*="reveal"] {
    opacity: 1 !important;
    transform: none !important;
    transition: none !important;
    animation: none !important;
    visibility: visible !important;
    will-change: auto !important;
  }

  /* 3. Estabilidad de imágenes */
  img {
    height: auto;
    max-width: 100%;
    content-visibility: auto;
  }

  /* 4. Eliminación de efectos de scroll que causan lag */
  * {
    overflow-anchor: none; 
  }
</style>