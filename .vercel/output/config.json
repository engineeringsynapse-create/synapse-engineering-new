{
	"version": 3,
	"routes": [
		{
			"src": "^/_astro/(.*)$",
			"headers": {
				"cache-control": "public, max-age=31536000, immutable"
			},
			"continue": true
		},
		{
			"handle": "filesystem"
		},
		{
			"src": "^\\/_image$",
			"dest": "_render"
		},
		{
			"src": "^\\/api\\/chat\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/clientes\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/contacto\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/disenos\\/([^/]+?)\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/disenos\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/empresa\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/productos\\/automatizacion-plc\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/productos\\/ccm-motores\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/productos\\/celdas-media-tension\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/productos\\/tableros-distribucion\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/productos\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/productos\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/soporte-ia\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/tienda\\/carrito\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/tienda\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/$",
			"dest": "_render"
		}
	]
}