---
import MainLayout from '../../layouts/MainLayout.astro';
import { ShieldCheck, Truck, Trash2, ShoppingCart } from 'lucide-react';
---

<MainLayout title="Carrito de Pedidos | Synapse Engineering">
  <main class="container mx-auto px-6 py-12 mt-10">
    <div class="flex gap-6 mb-8 text-sm font-bold text-slate-400">
      <span class="text-[#001529]">1. Orden</span> 
      <span>></span> 
      <span class="text-slate-300">2. Dirección</span> 
      <span>></span> 
      <span class="text-slate-300">3. Pago</span>
    </div>

    <h1 class="text-3xl font-black text-[#001529] uppercase mb-10 tracking-tighter">Resumen de la orden</h1>
    
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      <div class="lg:col-span-2 space-y-6">
        <div id="cart-items-list" class="space-y-4">
          <p class="text-slate-500 font-medium">Cargando productos...</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div class="flex items-center gap-3 p-4 bg-white border border-slate-100 rounded-2xl">
            <ShieldCheck className="text-emerald-500" />
            <div>
              <p class="text-xs font-black uppercase">Compra Segura</p>
              <p class="text-[10px] text-slate-400">Protección de datos SSL</p>
            </div>
          </div>
          <div class="flex items-center gap-3 p-4 bg-white border border-slate-100 rounded-2xl">
            <Truck className="text-blue-600" />
            <div>
              <p class="text-xs font-black uppercase">Envío Especializado</p>
              <p class="text-[10px] text-slate-400">Logística para equipos pesados</p>
            </div>
          </div>
        </div>
      </div>

      <div id="cart-summary" class="bg-white p-8 rounded-3xl border border-slate-100 shadow-xl h-fit">
        <h2 class="text-xl font-black mb-6 uppercase text-[#001529]">Total a Pagar</h2>
        <div class="space-y-4 text-sm font-bold border-b border-slate-100 pb-6 mb-6">
          <div class="flex justify-between"><span>Subtotal</span> <span id="full-subtotal">S/ 0.00</span></div>
          <div class="flex justify-between"><span>IGV (18%)</span> <span id="full-tax">S/ 0.00</span></div>
        </div>
        
        <div class="flex justify-between text-lg font-black mb-6">
            <span>Total Final</span> <span id="full-total" class="text-blue-900">S/ 0.00</span>
        </div>
        
        <button id="checkout-btn" class="w-full bg-[#001529] text-white py-4 rounded-xl font-black uppercase hover:bg-blue-900 transition-all cursor-pointer">
            Procesar Compra por WhatsApp
        </button>
      </div>
    </div>
  </main>
</MainLayout>

<script>
  import { $cart, $cartTotal, $subtotal, $igv, removeFromCart } from '../../lib/cart';

  function initCart() {
    const list = document.getElementById('cart-items-list')!;
    const summary = document.getElementById('cart-summary')!;
    const subTotalEl = document.getElementById('full-subtotal')!;
    const taxEl = document.getElementById('full-tax')!;
    const totalEl = document.getElementById('full-total')!;
    const checkoutBtn = document.getElementById('checkout-btn') as HTMLButtonElement;

    $cart.subscribe(items => {
      const cartArray = Object.values(items);
      
      if (cartArray.length === 0) {
        list.innerHTML = `
          <div class="flex flex-col items-center justify-center p-12 bg-white rounded-3xl border-2 border-dashed border-slate-200">
            <ShoppingCart size={48} class="text-slate-300 mb-4" />
            <h3 class="text-xl font-black text-slate-700 mb-2">¡Tu carrito está vacío!</h3>
            <p class="text-slate-400 mb-6 font-medium">Añade equipos a tu orden para comenzar.</p>
            <a href="/tienda" class="bg-[#001529] text-white px-8 py-3 rounded-xl font-black uppercase hover:bg-blue-900 transition-all">
              Ir a la Tienda
            </a>
          </div>
        `;
        summary.style.display = 'none';
      } else {
        summary.style.display = 'block';
        list.innerHTML = cartArray.map(item => `
          <div class="flex items-center gap-6 p-6 bg-white border border-slate-100 rounded-3xl shadow-sm">
            <img src="${item.product.img}" alt="${item.product.name}" class="w-20 h-20 object-contain bg-slate-50 rounded-xl" />
            <div class="flex-1">
              <h3 class="font-black text-slate-800 uppercase">${item.product.name}</h3>
              <p class="text-blue-600 font-bold text-xs">SKU: ${item.product.sku} | Cant: ${item.quantity}</p>
            </div>
            <p class="font-black text-[#001529]">S/ ${(item.product.price * item.quantity).toFixed(2)}</p>
            <button onclick="window.removeProduct(${item.product.id})" class="text-slate-400 hover:text-red-500 transition-colors p-2">
              <Trash2 size={20} />
            </button>
          </div>
        `).join('');
      }
    });

    // Actualización de precios
    $cartTotal.subscribe(val => totalEl.innerText = `S/ ${val.toFixed(2)}`);
    $subtotal.subscribe(val => subTotalEl.innerText = `S/ ${val.toFixed(2)}`);
    $igv.subscribe(val => taxEl.innerText = `S/ ${val.toFixed(2)}`);

    // WhatsApp
    checkoutBtn.addEventListener('click', () => {
      const items = Object.values($cart.get());
      const detalle = items.map(i => `\n- ${i.product.name} (x${i.quantity})`).join('');
      const msg = `Hola, quisiera realizar el siguiente pedido:${detalle}\n\nTotal: ${totalEl.innerText}`;
      window.open(`https://wa.me/51971444230?text=${encodeURIComponent(msg)}`, '_blank');
    });
  }

  (window as any).removeProduct = removeFromCart;
  initCart();
  document.addEventListener('astro:page-load', initCart);
</script>