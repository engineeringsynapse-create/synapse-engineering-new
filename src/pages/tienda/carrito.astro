---
import MainLayout from '../../layouts/MainLayout.astro';
import Navbar from '../../components/shared/Navbar.astro';
import Footer from '../../components/shared/Footer.astro';
import { ShieldCheck, Truck } from 'lucide-react';
---

<MainLayout title="Carrito de Pedidos | Synapse Engineering">
  <Navbar />
  
  <div class="bg-[#f8fafc] min-h-screen w-full py-1">
    <main class="container mx-auto px-4 md:px-6 py-12 mt-6 max-w-7xl">
      
      <div class="flex gap-4 mb-8 text-xs font-semibold uppercase tracking-wider text-slate-400">
        <span class="text-[#001529] border-b-2 border-[#001529] pb-1">1. Orden</span> 
        <span class="text-slate-300">/</span> 
        <span class="text-slate-400">2. Datos de Envío</span> 
        <span class="text-slate-300">/</span> 
        <span class="text-slate-400">3. Confirmación</span>
      </div>

      <h1 class="text-2xl font-black text-[#001529] uppercase mb-6 tracking-tight">Resumen de la orden</h1>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-start">
        <div class="lg:col-span-2 space-y-6">
          <div id="cart-items-list" class="space-y-4">
            <p class="text-slate-500 font-medium animate-pulse">Cargando productos...</p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 pt-4">
            <div class="flex items-center gap-4 p-5 bg-white border border-slate-100 rounded-xl shadow-sm">
              <div class="p-2 bg-emerald-50 rounded-lg"><ShieldCheck className="text-emerald-600 w-6 h-6" /></div>
              <div><p class="text-sm font-bold text-slate-800">Compra Segura</p><p class="text-xs text-slate-500">Datos cifrados SSL</p></div>
            </div>
            <div class="flex items-center gap-4 p-5 bg-white border border-slate-100 rounded-xl shadow-sm">
              <div class="p-2 bg-blue-50 rounded-lg"><Truck className="text-blue-600 w-6 h-6" /></div>
              <div><p class="text-sm font-bold text-slate-800">Envío Especializado</p><p class="text-xs text-slate-500">Logística pesada</p></div>
            </div>
          </div>
        </div>

        <div id="cart-summary" class="bg-white p-6 rounded-2xl border border-slate-200/60 shadow-sm sticky top-28">
          <h2 class="text-lg font-bold mb-5 text-[#001529]">Total a Pagar</h2>
          <div class="space-y-3 text-sm text-slate-600 border-b border-slate-100 pb-5 mb-5">
            <div class="flex justify-between"><span>Subtotal</span> <span id="full-subtotal" class="font-bold text-slate-900">S/ 0.00</span></div>
            <div class="flex justify-between"><span>IGV (18%)</span> <span id="full-tax" class="font-bold text-slate-900">S/ 0.00</span></div>
          </div>
          <div class="flex justify-between items-baseline mb-6 border-b border-slate-100 pb-5">
            <span class="text-base font-bold text-slate-900">Total Final</span> <span id="full-total" class="text-2xl font-black text-blue-800">S/ 0.00</span>
          </div>
          
          <button id="checkout-btn" class="w-full bg-[#001529] text-white py-4 px-4 rounded-xl text-sm font-bold uppercase tracking-wider hover:bg-blue-950 transition-all shadow-md">
            Procesar Compra →
          </button>
        </div>
      </div>
    </main>
    
    <Footer />
  </div>
</MainLayout>

<div id="checkout-modal" class="hidden fixed inset-0 bg-black/60 backdrop-blur-sm z-50 flex items-center justify-center p-4">
  <div class="bg-white rounded-2xl p-8 w-full max-w-sm shadow-2xl animate-in fade-in zoom-in duration-200">
    <h3 class="text-xl font-black text-[#001529] mb-6 uppercase">Datos de Facturación</h3>
    <div class="space-y-4">
      <div>
        <label class="block text-[10px] font-bold text-slate-400 uppercase mb-1">Nombre Completo</label>
        <input type="text" id="user-name" class="w-full p-3 bg-slate-50 border border-slate-200 rounded-lg text-sm focus:ring-2 focus:ring-blue-600 outline-none" placeholder="Nombre y Apellido">
      </div>
      <div>
        <label class="block text-[10px] font-bold text-slate-400 uppercase mb-1">DNI / RUC</label>
        <input type="text" id="user-doc" class="w-full p-3 bg-slate-50 border border-slate-200 rounded-lg text-sm focus:ring-2 focus:ring-blue-600 outline-none" placeholder="Número de documento">
      </div>
      <div class="flex gap-3 mt-8">
        <button id="close-modal" class="flex-1 py-3 text-slate-600 font-bold text-sm bg-slate-100 rounded-xl hover:bg-slate-200">Cancelar</button>
        <button id="submit-order" class="flex-1 py-3 bg-[#001529] text-white font-bold text-sm rounded-xl hover:bg-blue-950">Confirmar</button>
      </div>
    </div>
  </div>
</div>

<script>
  import { $cart, $cartTotal, $subtotal, $igv, removeFromCart } from '../../lib/cart';

  function initCart() {
    const list = document.getElementById('cart-items-list')!;
    const totalEl = document.getElementById('full-total')!;
    const checkoutBtn = document.getElementById('checkout-btn') as HTMLButtonElement;
    const modal = document.getElementById('checkout-modal')!;
    const closeBtn = document.getElementById('close-modal')!;
    const submitBtn = document.getElementById('submit-order')!;

    // UI Lógica
    checkoutBtn.addEventListener('click', () => modal.classList.remove('hidden'));
    closeBtn.addEventListener('click', () => modal.classList.add('hidden'));

    submitBtn.addEventListener('click', () => {
      const name = (document.getElementById('user-name') as HTMLInputElement).value;
      const doc = (document.getElementById('user-doc') as HTMLInputElement).value;
      
      if (!name || !doc) { alert("Por favor, completa tus datos."); return; }

      const currentItems = Object.values($cart.get());
      const detalle = currentItems.map(i => `\n- ${i.product.name} (x${i.quantity})`).join('');
      const msg = `Pedido Synapse Engineering:\n\n*Cliente:* ${name}\n*Documento:* ${doc}\n*Productos:*${detalle}\n\n*TOTAL:* ${totalEl.innerText}`;
      
      window.open(`https://wa.me/51971444230?text=${encodeURIComponent(msg)}`, '_blank');
      modal.classList.add('hidden');
    });

    // Subscripciones para renderizado... (el resto de tu lógica de carrito original sigue igual)
    // ... [Tu lógica original de renderizado de lista de productos]
  }
  
  // (Mantén tu lógica original de renderizado del carrito aquí dentro)
  (window as any).removeProduct = removeFromCart;
  initCart();
  document.addEventListener('astro:page-load', initCart);
</script>