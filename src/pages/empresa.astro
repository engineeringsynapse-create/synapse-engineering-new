---
import MainLayout from '../layouts/MainLayout.astro';
import WhyUs from '../sections/WhyUs.astro';

const values = [
  { title: "Misión", desc: "Desarrollar soluciones de ingeniería eléctrica de alta precisión que garanticen la seguridad y continuidad de los procesos industriales." },
  { title: "Visión", desc: "Ser el referente tecnológico en automatización y distribución eléctrica, impulsando la excelencia operativa." },
  { title: "Valores", desc: "Compromiso técnico, innovación constante, cumplimiento normativo y enfoque total en el éxito de nuestros clientes." }
];
---

<MainLayout title="La Empresa" description="Conoce a Synapse Engineering, líderes en soluciones eléctricas industriales.">
  
  <section class="bg-[#0b172a] py-24">
    <div class="container mx-auto px-6">
      <h1 class="text-5xl md:text-7xl font-black text-white mb-6 uppercase tracking-tighter">
        La Empresa
      </h1>
      <div class="w-20 h-2 bg-cyan-400 mb-8"></div>
      <p class="text-slate-300 text-lg max-w-2xl leading-relaxed">
        Ingeniería de vanguardia orientada a la eficiencia operativa y seguridad industrial.
      </p>
    </div>
  </section>

  <div class="py-10">
    <WhyUs />
  </div>

  <section class="py-20 bg-white">
    <div class="container mx-auto px-6">
      <div class="grid md:grid-cols-3 gap-8">
        {values.map((item) => (
          <div class="bg-slate-50 p-10 rounded-3xl border border-slate-100 hover:shadow-xl transition-shadow">
            <h3 class="text-blue-600 font-black text-2xl mb-4 uppercase">{item.title}</h3>
            <p class="text-slate-600 leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

</MainLayout>