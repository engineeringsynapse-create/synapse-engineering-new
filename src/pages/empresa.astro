---
import MainLayout from '../layouts/MainLayout.astro';
import WhyUs from '../sections/WhyUs.astro'; // <--- CORRECCIÓN AQUÍ
---

<MainLayout title="La Empresa" description="Conoce a Synapse Engineering, líderes en soluciones eléctricas industriales.">
  
  <section class="bg-slate-900 py-20">
    <div class="container mx-auto px-6 text-white">
      <h1 class="text-5xl md:text-6xl font-black mb-6 uppercase tracking-tighter">La Empresa</h1>
      <p class="text-slate-400 text-lg max-w-2xl">
        Ingeniería de vanguardia orientada a la eficiencia operativa y seguridad industrial.
      </p>
    </div>
  </section>

  <WhyUs />

  <section class="py-20 bg-slate-50">
    <div class="container mx-auto px-6">
      <div class="grid md:grid-cols-3 gap-8">
        {[
          { title: "Misión", desc: "Desarrollar soluciones de ingeniería eléctrica de alta precisión que garanticen la continuidad y seguridad de los procesos industriales." },
          { title: "Visión", desc: "Ser el referente tecnológico en automatización y distribución eléctrica a nivel regional, impulsando la industria 4.0." },
          { title: "Valores", desc: "Compromiso técnico, innovación constante, cumplimiento normativo y enfoque total en el éxito de nuestros clientes." }
        ].map(item => (
          <div class="bg-white p-8 rounded-2xl shadow-lg border border-slate-100 hover:border-blue-500 transition-all">
            <h3 class="text-blue-600 font-black text-xl mb-4">{item.title}</h3>
            <p class="text-slate-600 leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

</MainLayout>