---
import Layout from '../layouts/MainLayout.astro';
import Navbar from '../components/shared/Navbar.astro';
import Footer from '../components/shared/Footer.astro';
import WhyUs from '../sections/WhyUs.astro';

const values = [
  { title: "Misión", desc: "Desarrollar soluciones de ingeniería eléctrica de alta precisión que garanticen la seguridad y continuidad de los procesos industriales." },
  { title: "Visión", desc: "Ser el referente tecnológico en automatización y distribución eléctrica, impulsando la excelencia operativa." },
  { title: "Valores", desc: "Compromiso técnico, innovación constante, cumplimiento normativo y enfoque total en el éxito de nuestros clientes." }
];
---

<Layout title="La Empresa | Synapse Engineering">
  <Navbar />

  <div class="block md:hidden h-20"></div>

  <main class="bg-white">
    <section class="relative h-[40vh] md:h-[50vh] flex items-center bg-[#001529]">
      <div class="container mx-auto px-6 relative z-10">
        <h1 class="text-5xl md:text-7xl font-black text-white uppercase tracking-tighter mb-4">
          LA EMPRESA
        </h1>
        <div class="h-2 w-24 bg-cyan-500 mb-6"></div>
        <p class="text-slate-300 max-w-xl font-medium text-lg leading-relaxed">
          Ingeniería de vanguardia orientada a la eficiencia operativa y seguridad industrial.
        </p>
      </div>
    </section>

    <div class="py-10">
      <WhyUs />
    </div>

    <section class="py-20 bg-slate-50">
      <div class="container mx-auto px-6">
        <div class="grid md:grid-cols-3 gap-8">
          {values.map((item) => (
            <div class="bg-white p-10 rounded-2xl border border-slate-200 shadow-sm hover:shadow-xl transition-all">
              <h3 class="text-[#001529] font-black text-2xl mb-4 uppercase">{item.title}</h3>
              <p class="text-slate-600 leading-relaxed text-sm">{item.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>