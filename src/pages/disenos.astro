---
import Layout from '../layouts/MainLayout.astro';
import Navbar from '../components/shared/Navbar.astro';
import Footer from '../components/shared/Footer.astro';
import { Maximize2 } from 'lucide-react';

const designs = [
  { id: "tdf-01", title: "Tablero de distribución principal TDF-01", desc: "Recepción y distribución segura de energía con envolvente autosoportado.", img: "/images/tablero1.png", tags: ["Baja Tensión", "SolidWorks"] },
  { id: "jumbo-02", title: "Tablero de distribución JUMBO", desc: "Alta capacidad - Jumbo Series para entornos industriales exigentes.", img: "/images/tablero2.png", tags: ["Minería", "Racks"] },
  { id: "diseno-03", title: "Diseño de Ingeniería 03", desc: "Solución técnica optimizada para procesos de alta demanda energética.", img: "/images/tablero3.png", tags: ["Automatización", "CAD"] },
  { id: "diseno-04", title: "Diseño de Ingeniería 04", desc: "Precisión milimétrica en el modelado de componentes eléctricos.", img: "/images/tablero4.png", tags: ["Ingeniería", "3D"] },
  { id: "diseno-05", title: "Diseño de Ingeniería 05", desc: "Distribución eficiente para entornos de centros de control.", img: "/images/tablero5.png", tags: ["Distribución", "Baja Tensión"] },
  { id: "diseno-06", title: "Diseño de Ingeniería 06", desc: "Componentes de alta resistencia y durabilidad certificada.", img: "/images/tablero6.png", tags: ["Industrial", "Racks"] },
  { id: "diseno-07", title: "Diseño de Ingeniería 07", desc: "Integración de tableros con protocolos de seguridad avanzada.", img: "/images/tablero7.png", tags: ["Seguridad", "Energía"] },
  { id: "diseno-08", title: "Diseño de Ingeniería 08", desc: "Automatización aplicada para optimización de recursos eléctricos.", img: "/images/tablero8.png", tags: ["Minería", "Control"] },
  { id: "diseno-09", title: "Diseño de Ingeniería 09", desc: "Ingeniería de detalle en gabinetes de alta complejidad.", img: "/images/tablero9.png", tags: ["Ingeniería", "CAD"] },
  { id: "diseno-10", title: "Diseño de Ingeniería 10", desc: "Eficiencia energética comprobada en cada componente.", img: "/images/tablero10.png", tags: ["Industrial", "Baja Tensión"] },
  { id: "diseno-11", title: "Diseño de Ingeniería 11", desc: "Robustez y diseño ergonómico para mantenimiento sencillo.", img: "/images/tablero11.png", tags: ["Componentes", "SolidWorks"] },
  { id: "diseno-12", title: "Diseño de Ingeniería 12", desc: "Ingeniería avanzada para el sector minero industrial.", img: "/images/tablero12.png", tags: ["Minería", "Racks"] },
  { id: "diseno-13", title: "Diseño de Ingeniería 13", desc: "Alta disponibilidad para infraestructuras críticas.", img: "/images/tablero13.png", tags: ["Energía", "Industrial"] },
  { id: "diseno-14", title: "Diseño de Ingeniería 14", desc: "Innovación aplicada en gabinetes eléctricos modernos.", img: "/images/tablero14.png", tags: ["Automatización", "CAD"] },
  { id: "diseno-15", title: "Diseño de Ingeniería 15", desc: "Cumplimiento estricto con normativas internacionales.", img: "/images/tablero15.png", tags: ["Seguridad", "Baja Tensión"] },
  { id: "diseno-16", title: "Diseño de Ingeniería 16", desc: "Soluciones a medida para entornos de gran escala.", img: "/images/tablero16.png", tags: ["Industrial", "Ingeniería"] },
  { id: "diseno-17", title: "Diseño de Ingeniería 17", desc: "Calidad certificada y diseño de precisión.", img: "/images/tablero17.png", tags: ["Minería", "SolidWorks"] },
  { id: "diseno-18", title: "Diseño de Ingeniería 18", desc: "Distribución de energía optimizada y segura.", img: "/images/tablero18.png", tags: ["Distribución", "Racks"] },
  { id: "diseno-19", title: "Diseño de Ingeniería 19", desc: "Tecnología de punta en automatización de procesos.", img: "/images/tablero19.png", tags: ["Automatización", "Industrial"] },
  { id: "diseno-20", title: "Diseño de Ingeniería 20", desc: "Precisión máxima para resultados garantizados.", img: "/images/tablero20.png", tags: ["Ingeniería", "3D"] }
];
---

<Layout title="Diseños de Ingeniería | Synapse Engineering">
  <Navbar />
  
  <div class="block md:hidden h-20"></div>

  <main class="bg-white">
    <section class="relative h-[40vh] md:h-[50vh] flex items-center bg-[#001529]">
      <div class="container mx-auto px-6 relative z-10">
        <h1 class="text-5xl md:text-7xl font-black text-white uppercase tracking-tighter mb-4">
          DISEÑOS <span class="text-cyan-400">3D</span>
        </h1>
        <div class="h-2 w-24 bg-cyan-500 mb-6"></div>
        <p class="text-slate-300 max-w-xl font-medium text-lg leading-relaxed">
          Ingeniería de detalle aplicada a cada componente para garantizar precisión milimétrica.
        </p>
      </div>
    </section>

    <section class="py-20 bg-slate-50">
      <div class="container mx-auto px-6">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10">
          {designs.map((design) => (
            <div class="bg-white rounded-2xl border border-slate-200 overflow-hidden shadow-sm hover:shadow-xl transition-all flex flex-col h-full">
              <div class="relative h-64 bg-slate-50 flex items-center justify-center p-6 border-b border-slate-100">
                <img 
                  src={design.img} 
                  class="max-h-full object-contain border border-slate-200 rounded-md shadow-sm bg-white" 
                  alt={design.title} 
                />
                <div class="absolute top-4 right-4 flex gap-2">
                  {design.tags.map(tag => (
                    <span class="bg-[#001529] text-white text-[9px] font-black px-2.5 py-1 rounded-full uppercase tracking-wider">
                      {tag}
                    </span>
                  ))}
                </div>
              </div>
              
              <div class="p-8 flex flex-col flex-grow">
                <h3 class="text-xl font-black text-[#001529] uppercase tracking-tight mb-3">
                  {design.title}
                </h3>
                <p class="text-slate-500 text-sm font-medium leading-relaxed mb-8 flex-grow">
                  {design.desc}
                </p>
                
                <a 
                  href={`/disenos/${design.id}`} 
                  class="w-full bg-[#001529] hover:bg-blue-800 text-white text-[11px] font-black py-4 rounded-lg transition-all text-center tracking-widest uppercase flex items-center justify-center gap-2"
                >
                  Ver ficha técnica completa <Maximize2 size={14} />
                </a>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>