---
import Layout from '../layouts/MainLayout.astro';
import Navbar from '../components/shared/Navbar.astro';
import Footer from '../components/shared/Footer.astro';
import { Maximize2 } from 'lucide-react';

const designs = [
  { id: "tdf-01", title: "Tablero de distribución TDF-01", desc: "Recepción y distribución segura de energía.", img: "https://images.unsplash.com/photo-1581092334651-ddf26d9a1930?auto=format&fit=crop&q=80", tags: ["Baja Tensión", "SolidWorks"] },
  { id: "jumbo-02", title: "Tablero de distribución JUMBO", desc: "Alta capacidad para entornos industriales.", img: "https://images.unsplash.com/photo-1581092335397-9583ee92d0bb?auto=format&fit=crop&q=80", tags: ["Minería", "Racks"] },
  { id: "diseno-03", title: "Diseño 3D Industrial 03", desc: "Detalle técnico para sistemas eléctricos.", img: "https://images.unsplash.com/photo-1581092334651-ddf26d9a1930?auto=format&fit=crop&q=80", tags: ["Automatización", "CAD"] },
  { id: "diseno-04", title: "Diseño 3D Industrial 04", desc: "Precisión milimétrica en componentes.", img: "https://images.unsplash.com/photo-1581092335397-9583ee92d0bb?auto=format&fit=crop&q=80", tags: ["Ingeniería", "3D"] },
  { id: "diseno-05", title: "Diseño 3D Industrial 05", desc: "Optimización de espacios eléctricos.", img: "https://images.unsplash.com/photo-1581092334651-ddf26d9a1930?auto=format&fit=crop&q=80", tags: ["Distribución", "Baja Tensión"] },
  { id: "diseno-06", title: "Diseño 3D Industrial 06", desc: "Componentes de alta resistencia.", img: "https://images.unsplash.com/photo-1581092335397-9583ee92d0bb?auto=format&fit=crop&q=80", tags: ["Industrial", "Racks"] },
  { id: "diseno-07", title: "Diseño 3D Industrial 07", desc: "Integración de tableros eléctricos.", img: "https://images.unsplash.com/photo-1581092334651-ddf26d9a1930?auto=format&fit=crop&q=80", tags: ["Seguridad", "Energía"] },
  { id: "diseno-08", title: "Diseño 3D Industrial 08", desc: "Soluciones de automatización.", img: "https://images.unsplash.com/photo-1581092335397-9583ee92d0bb?auto=format&fit=crop&q=80", tags: ["Minería", "Control"] },
  { id: "diseno-09", title: "Diseño 3D Industrial 09", desc: "Precisión técnica y diseño.", img: "https://images.unsplash.com/photo-1581092334651-ddf26d9a1930?auto=format&fit=crop&q=80", tags: ["Ingeniería", "CAD"] },
  { id: "diseno-10", title: "Diseño 3D Industrial 10", desc: "Eficiencia en cada componente.", img: "https://images.unsplash.com/photo-1581092335397-9583ee92d0bb?auto=format&fit=crop&q=80", tags: ["Industrial", "Baja Tensión"] },
  { id: "diseno-11", title: "Diseño 3D Industrial 11", desc: "Robustez en diseño 3D.", img: "https://images.unsplash.com/photo-1581092334651-ddf26d9a1930?auto=format&fit=crop&q=80", tags: ["Componentes", "SolidWorks"] },
  { id: "diseno-12", title: "Diseño 3D Industrial 12", desc: "Ingeniería de detalle.", img: "https://images.unsplash.com/photo-1581092335397-9583ee92d0bb?auto=format&fit=crop&q=80", tags: ["Minería", "Racks"] },
  { id: "diseno-13", title: "Diseño 3D Industrial 13", desc: "Alta disponibilidad de energía.", img: "https://images.unsplash.com/photo-1581092334651-ddf26d9a1930?auto=format&fit=crop&q=80", tags: ["Energía", "Industrial"] },
  { id: "diseno-14", title: "Diseño 3D Industrial 14", desc: "Innovación en tableros.", img: "https://images.unsplash.com/photo-1581092335397-9583ee92d0bb?auto=format&fit=crop&q=80", tags: ["Automatización", "CAD"] },
  { id: "diseno-15", title: "Diseño 3D Industrial 15", desc: "Cumplimiento normativo.", img: "https://images.unsplash.com/photo-1581092334651-ddf26d9a1930?auto=format&fit=crop&q=80", tags: ["Seguridad", "Baja Tensión"] },
  { id: "diseno-16", title: "Diseño 3D Industrial 16", desc: "Soluciones a medida.", img: "https://images.unsplash.com/photo-1581092335397-9583ee92d0bb?auto=format&fit=crop&q=80", tags: ["Industrial", "Ingeniería"] },
  { id: "diseno-17", title: "Diseño 3D Industrial 17", desc: "Calidad certificada.", img: "https://images.unsplash.com/photo-1581092334651-ddf26d9a1930?auto=format&fit=crop&q=80", tags: ["Minería", "SolidWorks"] },
  { id: "diseno-18", title: "Diseño 3D Industrial 18", desc: "Distribución optimizada.", img: "https://images.unsplash.com/photo-1581092335397-9583ee92d0bb?auto=format&fit=crop&q=80", tags: ["Distribución", "Racks"] },
  { id: "diseno-19", title: "Diseño 3D Industrial 19", desc: "Tecnología avanzada.", img: "https://images.unsplash.com/photo-1581092334651-ddf26d9a1930?auto=format&fit=crop&q=80", tags: ["Automatización", "Industrial"] },
  { id: "diseno-20", title: "Diseño 3D Industrial 20", desc: "Precisión máxima.", img: "https://images.unsplash.com/photo-1581092335397-9583ee92d0bb?auto=format&fit=crop&q=80", tags: ["Ingeniería", "3D"] }
];
---

<Layout title="Diseños de Ingeniería | Synapse Engineering">
  <Navbar />
  
  <div class="block md:hidden h-20"></div>

  <main class="bg-white">
    <section class="relative h-[40vh] md:h-[50vh] flex items-center bg-[#001529]">
      <div class="container mx-auto px-6 relative z-10">
        <h1 class="text-5xl md:text-7xl font-black text-white uppercase tracking-tighter mb-4">
          DISEÑOS <span class="text-cyan-400">3D</span>
        </h1>
        <div class="h-2 w-24 bg-cyan-500 mb-6"></div>
        <p class="text-slate-300 max-w-xl font-medium text-lg leading-relaxed">
          Ingeniería de detalle aplicada a cada componente para garantizar precisión milimétrica.
        </p>
      </div>
    </section>

    <section class="py-20 bg-slate-50">
      <div class="container mx-auto px-6">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
          {designs.map((design) => (
            <div class="bg-white rounded-2xl border border-slate-200 overflow-hidden shadow-sm hover:shadow-xl transition-all flex flex-col h-full">
              <div class="relative h-64 bg-slate-100 flex items-center justify-center p-6">
                <img src={design.img} class="max-h-full object-contain" alt={design.title} />
                <div class="absolute top-4 right-4 flex gap-2">
                  {design.tags.map(tag => (
                    <span class="bg-[#001529] text-white text-[9px] font-black px-2.5 py-1 rounded-full uppercase tracking-wider">
                      {tag}
                    </span>
                  ))}
                </div>
              </div>
              
              <div class="p-6 flex flex-col flex-grow">
                <h3 class="text-lg font-black text-[#001529] uppercase tracking-tight mb-3">
                  {design.title}
                </h3>
                <p class="text-slate-500 text-sm font-medium leading-relaxed mb-6 flex-grow">
                  {design.desc}
                </p>
                
                <a 
                  href={`/disenos/${design.id}`} 
                  class="w-full bg-[#001529] hover:bg-blue-800 text-white text-[11px] font-black py-3 rounded-lg transition-all text-center tracking-widest uppercase flex items-center justify-center gap-2"
                >
                  Ver ficha técnica <Maximize2 size={12} />
                </a>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>