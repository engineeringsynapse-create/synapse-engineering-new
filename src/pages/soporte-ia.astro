---
import Layout from '../layouts/MainLayout.astro';
import Navbar from '../components/shared/Navbar.astro';
import Footer from '../components/shared/Footer.astro';
import { Send, Plus, Menu, X, Trash2, Mic, Camera, Paperclip, Triangle, Image as ImageIcon } from 'lucide-react';
---

<Layout title="Soporte IA | Synapse Engineering">
  <Navbar />
  
  <main>
    <div id="delete-modal" class="fixed inset-0 z-[100] hidden items-center justify-center p-4">
      <div class="absolute inset-0 bg-slate-900/60 backdrop-blur-sm"></div>
      <div class="bg-white rounded-[32px] p-8 max-w-sm w-full relative z-10 shadow-2xl border border-slate-100 animate-in zoom-in-95 duration-200">
        <div class="flex justify-center mb-6">
          <div class="w-16 h-16 bg-red-50 rounded-full flex items-center justify-center text-red-500">
            <Trash2 size={32} />
          </div>
        </div>
        <h3 class="text-xl font-black text-slate-900 text-center mb-2 uppercase tracking-tight">¿Eliminar chat?</h3>
        <p class="text-slate-500 text-center text-sm mb-8 leading-relaxed">
          Esto eliminará permanentemente la conversación <span id="modal-chat-name" class="font-bold text-slate-700"></span>.
        </p>
        <div class="flex gap-3">
          <button id="cancel-delete" class="flex-1 py-4 bg-slate-100 hover:bg-slate-200 text-slate-600 rounded-2xl font-bold text-xs uppercase tracking-widest transition-all">Cancelar</button>
          <button id="confirm-delete" class="flex-1 py-4 bg-red-500 hover:bg-red-600 text-white rounded-2xl font-bold text-xs uppercase tracking-widest transition-all shadow-lg">Eliminar</button>
        </div>
      </div>
    </div>

    <section class="bg-[#001529] flex items-center h-[50vh] pt-28 pb-12 md:pt-0 md:pb-0 border-b border-white/5 overflow-hidden relative">
      <div class="absolute inset-0 opacity-5 bg-[url('/grid-light.svg')] bg-center pointer-events-none"></div>
      <div class="container mx-auto px-6 relative z-10">
        <span class="text-cyan-400 text-[10px] font-black uppercase tracking-[0.3em] mb-4 block animate-pulse">SISTEMA OPERATIVO V2.0</span>
        <h1 class="text-5xl md:text-7xl font-black text-white uppercase tracking-tighter leading-none mb-4">
          SOPORTE <span class="text-cyan-400 block md:inline">INTELIGENTE</span>
        </h1>
        <div class="h-2 w-24 bg-cyan-500 mt-6"></div>
        <p class="text-slate-300 mt-6 max-w-xl text-lg font-medium leading-relaxed italic">
          Asesoría técnica inmediata bajo normativa <span class="text-white font-bold">IEC 61439-1</span> para ingeniería eléctrica.
        </p>
      </div>
    </section>

    <section class="py-12 md:py-24 bg-[#f8fafc] relative min-h-[800px]">
      <div class="container mx-auto px-6">
        <div class="bg-white rounded-[40px] shadow-[0_40px_80px_-15px_rgba(0,0,0,0.1)] border border-slate-200 overflow-hidden flex h-[750px] max-w-6xl mx-auto relative">
          
          <aside id="sidebar" class="absolute inset-y-0 left-0 z-40 w-72 bg-slate-50 border-r border-slate-100 transition-all duration-300 transform -translate-x-full md:relative md:flex md:translate-x-0 md:min-w-[288px] flex flex-col overflow-hidden">
            <button id="close-sidebar" class="md:hidden absolute top-2 right-2 p-3 text-slate-400 hover:text-red-500 transition-colors z-50">
              <X size={20} />
            </button>

            <div class="p-6 flex flex-col h-full min-w-[288px] relative">
              <button id="new-chat-btn" class="flex items-center justify-center gap-2 w-full py-4 bg-[#001529] text-white rounded-2xl hover:bg-blue-600 transition-all font-bold text-xs shadow-lg mb-6 uppercase tracking-widest whitespace-nowrap mt-4">
                <Plus size={16} /> Nuevo Chat
              </button>

              <div class="text-[10px] text-slate-400 font-black uppercase tracking-widest mb-4 px-2 whitespace-nowrap">Conversaciones</div>
              <div id="chat-list" class="flex-1 overflow-y-auto space-y-2 pr-2 custom-scrollbar"></div>
            </div>
          </aside>

          <div id="sidebar-overlay" class="fixed inset-0 bg-black/20 backdrop-blur-sm z-30 hidden md:hidden transition-opacity"></div>

          <div class="flex-1 flex flex-col min-w-0 relative">
            <div class="px-8 py-5 border-b border-slate-100 bg-slate-50/50 flex justify-between items-center relative z-20">
              <div class="flex items-center gap-3">
                <button id="toggle-sidebar" class="p-2 text-slate-600 hover:bg-slate-200 rounded-lg transition-colors">
                  <Menu size={20} />
                </button>
                <div class="flex gap-1.5 hidden sm:flex">
                    <div class="w-3 h-3 rounded-full bg-red-400"></div>
                    <div class="w-3 h-3 rounded-full bg-amber-400"></div>
                    <div class="w-3 h-3 rounded-full bg-emerald-400"></div>
                </div>
                <span class="text-[11px] font-black text-blue-600 uppercase tracking-widest italic ml-2 truncate">
                    ASISTENTE IA DE SYNAPSE
                </span>
              </div>
              <div id="status-ia" class="flex items-center gap-2">
                  <span class="relative flex h-2 w-2">
                      <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                      <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
                  </span>
                  <span class="text-[10px] font-bold text-slate-400 uppercase hidden sm:inline">En línea</span>
              </div>
            </div>

            <!-- FIX SCROLL: Ampliamos radicalmente el padding-bottom (pb-60 md:pb-72) para evitar que las tarjetas choquen con la barra de input en PC -->
            <div id="chat-box" class="flex-1 overflow-y-auto overflow-x-hidden p-4 md:p-10 space-y-8 custom-scrollbar pb-60 md:pb-72 z-0"></div>

            <form id="chat-form" class="absolute bottom-0 w-full p-4 md:p-6 bg-white/95 backdrop-blur-md border-t border-slate-100 z-40">
              <div class="max-w-4xl mx-auto relative flex flex-col items-start w-full">
                
                <div id="image-preview-container" class="hidden mb-4 relative ml-4">
                  <div class="p-1 bg-white border border-slate-200 rounded-2xl shadow-sm">
                    <img id="image-preview" src="" class="h-20 w-20 md:h-24 md:w-24 rounded-xl object-cover" alt="Previsualización" />
                  </div>
                  <button type="button" id="remove-image" class="absolute -top-3 -right-3 bg-slate-800 text-white rounded-full p-1.5 hover:bg-red-500 transition-colors shadow-md z-10">
                    <X size={14} strokeWidth={3} />
                  </button>
                </div>

                <div class="relative flex items-center bg-white rounded-[24px] border-2 border-slate-200 focus-within:border-blue-600 focus-within:shadow-lg transition-all shadow-sm w-full p-1.5 min-w-0">
                  
                  <div id="attach-menu" class="hidden absolute bottom-full left-0 mb-4 bg-white p-5 rounded-3xl shadow-[0_20px_60px_-10px_rgba(0,0,0,0.15)] border border-slate-100 flex gap-4 md:gap-6 z-50 animate-in slide-in-from-bottom-2">
                    <button type="button" id="btn-camera" class="flex flex-col items-center gap-2 group">
                      <div class="w-14 h-14 bg-slate-50 group-hover:bg-blue-50 border border-slate-100 group-hover:border-blue-100 rounded-full flex items-center justify-center text-slate-500 group-hover:text-blue-600 transition-all shadow-sm">
                        <Camera size={24} strokeWidth={1.5} />
                      </div>
                      <span class="text-slate-600 text-[10px] font-bold uppercase tracking-wider">Cámara</span>
                    </button>
                    <button type="button" id="btn-archivos" class="flex flex-col items-center gap-2 group">
                      <div class="w-14 h-14 bg-slate-50 group-hover:bg-blue-50 border border-slate-100 group-hover:border-blue-100 rounded-full flex items-center justify-center text-slate-500 group-hover:text-blue-600 transition-all shadow-sm">
                        <Paperclip size={24} strokeWidth={1.5} />
                      </div>
                      <span class="text-slate-600 text-[10px] font-bold uppercase tracking-wider">Archivos</span>
                    </button>
                    <button type="button" id="btn-drive" class="flex flex-col items-center gap-2 group">
                      <div class="w-14 h-14 bg-slate-50 group-hover:bg-blue-50 border border-slate-100 group-hover:border-blue-100 rounded-full flex items-center justify-center text-slate-500 group-hover:text-blue-600 transition-all shadow-sm">
                        <Triangle size={24} strokeWidth={1.5} class="rotate-180" />
                      </div>
                      <span class="text-slate-600 text-[10px] font-bold uppercase tracking-wider">Drive</span>
                    </button>
                    <button type="button" id="btn-fotos" class="flex flex-col items-center gap-2 group">
                      <div class="w-14 h-14 bg-slate-50 group-hover:bg-blue-50 border border-slate-100 group-hover:border-blue-100 rounded-full flex items-center justify-center text-slate-500 group-hover:text-blue-600 transition-all shadow-sm">
                        <ImageIcon size={24} strokeWidth={1.5} />
                      </div>
                      <span class="text-slate-600 text-[10px] font-bold uppercase tracking-wider">Fotos</span>
                    </button>
                  </div>

                  <div id="text-input-wrapper" class="flex items-center flex-1 min-w-0 w-full transition-all">
                    <button type="button" id="attach-btn" class="p-2 md:p-3 text-slate-400 hover:text-[#001529] hover:bg-slate-100 rounded-xl transition-colors flex-shrink-0">
                      <Plus size={24} strokeWidth={2.5} />
                    </button>
                    <input type="file" id="file-input" accept="image/*" class="hidden" />
                    <input type="file" id="camera-input" accept="image/*" capture="environment" class="hidden" />
                    
                    <input id="user-input" type="text" autocomplete="off" placeholder="Describa su requerimiento..." class="flex-1 w-full bg-transparent py-2 md:py-3 px-2 md:px-3 text-sm focus:outline-none text-slate-700 font-medium placeholder-slate-400 min-w-0" />
                  </div>

                  <!-- CONTENEDOR DE GRABACIÓN DE AUDIO -->
                  <div id="audio-record-wrapper" class="hidden flex-1 items-center bg-blue-50/50 rounded-2xl px-2 md:px-4 py-2 border border-blue-100 min-w-0 overflow-hidden">
                    <div class="w-2.5 h-2.5 rounded-full bg-red-500 animate-pulse mr-2 md:mr-3 flex-shrink-0"></div>
                    <span id="record-time" class="text-[10px] md:text-xs font-bold text-slate-600 w-6 md:w-8">0:00</span>
                    
                    <!-- Ondas Animadas -->
                    <div class="flex items-center gap-1 h-6 flex-1 px-2 md:px-4 justify-center">
                      <div class="w-1 bg-blue-400 rounded-full h-2/3 animate-[bounce_1s_infinite]"></div>
                      <div class="w-1 bg-blue-400 rounded-full h-full animate-[bounce_1.2s_infinite]"></div>
                      <div class="w-1 bg-blue-400 rounded-full h-1/2 animate-[bounce_0.8s_infinite]"></div>
                      <div class="w-1 bg-blue-400 rounded-full h-3/4 animate-[bounce_1.1s_infinite]"></div>
                      <div class="w-1 bg-blue-400 rounded-full h-1/3 animate-[bounce_0.9s_infinite]"></div>
                      <div class="w-1 bg-blue-400 rounded-full h-full animate-[bounce_1.3s_infinite]"></div>
                      <div class="w-1 bg-blue-400 rounded-full h-2/3 hidden md:block animate-[bounce_1.5s_infinite]"></div>
                    </div>
                    
                    <button type="button" id="cancel-mic-btn" class="p-2 text-slate-400 hover:text-red-500 transition-colors flex-shrink-0">
                      <Trash2 size={18} />
                    </button>
                  </div>
                  
                  <div class="flex items-center gap-1 pr-1 flex-shrink-0">
                    <button type="button" id="mic-btn" class="p-2 md:p-3 text-slate-400 hover:text-blue-600 hover:bg-blue-50 transition-all rounded-xl relative">
                      <Mic size={22} strokeWidth={2} />
                    </button>
                    
                    <button type="submit" id="send-btn" class="bg-[#001529] text-white p-2 md:p-4 rounded-xl hover:bg-blue-600 transition-all shadow-md flex items-center justify-center">
                      <Send size={20} />
                    </button>
                  </div>

                </div>
              </div>
            </form>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<script>
  const chatBox = document.getElementById('chat-box');
  const chatForm = document.getElementById('chat-form');
  const userInput = document.getElementById('user-input') as HTMLInputElement;
  const chatList = document.getElementById('chat-list');
  const newChatBtn = document.getElementById('new-chat-btn');
  const toggleSidebar = document.getElementById('toggle-sidebar');
  const closeSidebar = document.getElementById('close-sidebar');
  const sidebar = document.getElementById('sidebar');
  const overlay = document.getElementById('sidebar-overlay');
  const deleteModal = document.getElementById('delete-modal');
  const modalChatName = document.getElementById('modal-chat-name');

  const attachBtn = document.getElementById('attach-btn');
  const attachMenu = document.getElementById('attach-menu');
  const fileInput = document.getElementById('file-input') as HTMLInputElement;
  const cameraInput = document.getElementById('camera-input') as HTMLInputElement;
  const imgPreviewContainer = document.getElementById('image-preview-container');
  const imgPreview = document.getElementById('image-preview') as HTMLImageElement;
  const removeImgBtn = document.getElementById('remove-image');
  
  const textWrapper = document.getElementById('text-input-wrapper');
  const audioWrapper = document.getElementById('audio-record-wrapper');
  const micBtn = document.getElementById('mic-btn');
  const cancelMicBtn = document.getElementById('cancel-mic-btn');
  const sendBtn = document.getElementById('send-btn');
  const recordTime = document.getElementById('record-time');

  let currentChatId = localStorage.getItem('active_chat_id') || Date.now().toString();
  let chatHistory = JSON.parse(localStorage.getItem('synapse_history') || '[]');
  let idToDelete = "";
  let currentImageData = null;
  let isRecording = false;
  let audioTranscript = "";
  let recordInterval;
  let recordSeconds = 0;

  // Variables para Grabación de Audio Real
  let mediaRecorder;
  let audioChunks = [];
  let resolveAudioPromise;

  const WELCOME_MSG = "Saludos. Soy el asistente inteligente de **Synapse Engineering**. ¿En qué puedo asesorarle hoy? Puede enviarme consultas técnicas, notas de voz o imágenes de diagramas y tableros.";

  // ==========================================
  // SCROLL PERFECTO PARA PC Y MÓVIL (CORREGIDO)
  // ==========================================
  function scrollToBottom() {
    const scroll = () => {
      if(chatBox) {
        chatBox.scrollTo({
          top: chatBox.scrollHeight + 5000, // Fuerza un valor excesivo para asegurar que llegue al final
          behavior: 'smooth'
        });
      }
    };
    // Doble gatillo: Inmediato y con retraso para esperar al renderizado completo de las imágenes/textos
    setTimeout(scroll, 100);
    setTimeout(scroll, 600); 
  }

  // Parseador de Markdown limpio
  function parseMarkdownToHTML(text) {
    if (!text) return "";
    let html = text
      .replace(/^### (.*$)/gim, '<h3 class="text-sm font-black text-blue-700 mt-5 mb-2 uppercase tracking-wide">$1</h3>')
      .replace(/^## (.*$)/gim, '<h2 class="text-base font-black text-[#001529] mt-5 mb-2 uppercase tracking-wider">$1</h2>')
      .replace(/^# (.*$)/gim, '<h1 class="text-lg font-black text-[#001529] mt-5 mb-2 uppercase tracking-widest">$1</h1>')
      .replace(/\*\*(.*?)\*\*/g, '<strong class="font-bold text-slate-800">$1</strong>')
      .replace(/\*(.*?)\*/g, '<em class="text-slate-600">$1</em>')
      .replace(/^\- (.*$)/gim, '<li class="ml-4 mb-1 list-disc marker:text-blue-500">$1</li>')
      .replace(/\n/g, '<br/>');

    return html.replace(/(<br\/>){3,}/g, '<br/><br/>');
  }

  function compressImage(file, maxWidth = 800) {
    return new Promise((resolve) => {
      const reader = new FileReader();
      reader.readAsDataURL(file);
      reader.onload = (event) => {
        const img = new Image();
        img.src = event.target?.result as string;
        img.onload = () => {
          const canvas = document.createElement('canvas');
          const scaleSize = maxWidth / img.width;
          canvas.width = maxWidth;
          canvas.height = img.height * scaleSize;
          const ctx = canvas.getContext('2d');
          ctx?.drawImage(img, 0, 0, canvas.width, canvas.height);
          resolve(canvas.toDataURL('image/jpeg', 0.6));
        };
      };
    });
  }

  attachBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    attachMenu?.classList.toggle('hidden');
  });

  window.addEventListener('click', (e) => {
    if (!attachMenu?.contains(e.target as Node) && e.target !== attachBtn) {
      attachMenu?.classList.add('hidden');
    }
  });

  document.getElementById('btn-fotos')?.addEventListener('click', () => fileInput.click());
  document.getElementById('btn-archivos')?.addEventListener('click', () => fileInput.click());
  document.getElementById('btn-drive')?.addEventListener('click', () => fileInput.click());
  document.getElementById('btn-camera')?.addEventListener('click', () => cameraInput.click());

  async function handleImageUpload(e) {
    const file = e.target.files[0];
    if (file) {
      currentImageData = await compressImage(file);
      imgPreview.src = currentImageData;
      imgPreviewContainer?.classList.remove('hidden');
      attachMenu?.classList.add('hidden');
      scrollToBottom(); 
    }
  }

  fileInput?.addEventListener('change', handleImageUpload);
  cameraInput?.addEventListener('change', handleImageUpload);

  removeImgBtn?.addEventListener('click', () => {
    currentImageData = null;
    imgPreviewContainer?.classList.add('hidden');
    fileInput.value = '';
    cameraInput.value = '';
  });

  // ==========================================
  // GRABADORA DE VOZ REAL (API NATIVA)
  // ==========================================
  let recognition;
  if ('webkitSpeechRecognition' in window || 'SpeechRecognition' in window) {
    const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
    recognition = new SpeechRecognition();
    recognition.lang = 'es-ES';
    recognition.interimResults = true;
    recognition.continuous = true;

    recognition.onresult = (e) => {
      let finalTranscript = '';
      for (let i = e.resultIndex; i < e.results.length; ++i) {
        if (e.results[i].isFinal) finalTranscript += e.results[i][0].transcript;
      }
      if (finalTranscript) audioTranscript += finalTranscript + ' ';
    };

    recognition.onend = () => {
      if (isRecording) recognition.start(); 
    };
  }

  function formatTime(sec) {
    if (isNaN(sec)) return "0:00";
    const m = Math.floor(sec / 60);
    const s = sec % 60;
    return `${m}:${s.toString().padStart(2, '0')}`;
  }

  async function startRecording() {
    isRecording = true;
    audioTranscript = "";
    recordSeconds = 0;
    recordTime!.innerText = "0:00";
    audioChunks = [];
    
    textWrapper?.classList.add('hidden');
    micBtn?.classList.add('hidden');
    audioWrapper?.classList.replace('hidden', 'flex');
    sendBtn?.classList.replace('bg-[#001529]', 'bg-blue-600');
    sendBtn?.classList.add('animate-pulse');

    try {
      const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
      mediaRecorder = new MediaRecorder(stream);
      
      mediaRecorder.ondataavailable = (e) => {
        if (e.data.size > 0) audioChunks.push(e.data);
      };
      
      mediaRecorder.onstop = () => {
        const audioBlob = new Blob(audioChunks, { type: 'audio/webm' });
        const reader = new FileReader();
        reader.readAsDataURL(audioBlob);
        reader.onloadend = () => {
           if(resolveAudioPromise) resolveAudioPromise(reader.result); // Retorna Base64
        }
      };

      mediaRecorder.start();
      if (recognition) recognition.start();
      
      recordInterval = setInterval(() => {
        recordSeconds++;
        recordTime!.innerText = formatTime(recordSeconds);
      }, 1000);
      
    } catch (err) {
      console.error("Error al acceder al micrófono:", err);
      stopRecording(true);
    }
  }

  function stopRecording(cancel = false) {
    return new Promise((resolve) => {
      isRecording = false;
      resolveAudioPromise = cancel ? () => resolve(null) : resolve;
      
      clearInterval(recordInterval);
      if (recognition) recognition.stop();
      
      if (mediaRecorder && mediaRecorder.state !== "inactive") {
        mediaRecorder.stop();
        mediaRecorder.stream.getTracks().forEach(track => track.stop());
      } else {
        resolve(null);
      }
      
      audioWrapper?.classList.replace('flex', 'hidden');
      textWrapper?.classList.remove('hidden');
      micBtn?.classList.remove('hidden');
      sendBtn?.classList.replace('bg-blue-600', 'bg-[#001529]');
      sendBtn?.classList.remove('animate-pulse');
      
      if (cancel) audioTranscript = "";
    });
  }

  micBtn?.addEventListener('click', () => {
    if (!isRecording) startRecording();
  });

  cancelMicBtn?.addEventListener('click', () => {
    stopRecording(true);
  });

  // ==========================================
  // MOTOR DEL CHAT (Lógica API)
  // ==========================================
  async function getAIResponse(message, image = null) {
    const chat = chatHistory.find(c => c.id === currentChatId);
    const isReturningUser = chat && chat.messages.length > 0;
    const finalMessage = isReturningUser 
      ? `[Usuario frecuente]: ${message}` 
      : message;

    const payload = { message: finalMessage, image: image };

    const response = await fetch(`${window.location.origin}/api/chat`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload)
    });
    const data = await response.json();
    return data.response;
  }

  function loadActiveChat() {
    if (!chatBox) return;
    chatBox.innerHTML = '';
    const chat = chatHistory.find(c => c.id === currentChatId);
    if (chat && chat.messages.length > 0) {
      chat.messages.forEach(m => chatBox.appendChild(createMessage(m.text, m.role === 'ai', m.id, m.image, m.audioData)));
    } else {
      chatBox.appendChild(createMessage(WELCOME_MSG, true, 'welcome'));
    }
    scrollToBottom();
  }

  // Modificada para recibir y reproducir audioData real
  function createMessage(text, isAi, specificId, imageStr = null, audioData = null) {
    const div = document.createElement('div');
    const msgId = specificId;
    div.className = `group flex gap-3 md:gap-5 max-w-4xl relative mb-4 ${isAi ? '' : 'ml-auto flex-row-reverse animate-in fade-in slide-in-from-right-4'}`;
    
    const formattedText = parseMarkdownToHTML(text);
    const toolPosition = isAi ? 'top-1 right-4' : 'top-1 left-4';
    
    let mediaHtml = '';
    if (imageStr) {
      mediaHtml = `<img src="${imageStr}" class="max-w-full h-auto rounded-xl mb-3 border border-slate-200 shadow-sm max-h-64 object-contain" alt="Adjunto" />`;
    }

    // REPRODUCTOR DE AUDIO REAL
    let audioHtml = '';
    if (audioData) {
      audioHtml = `
        <audio id="audio-el-${msgId}" src="${audioData}" preload="metadata" class="hidden"></audio>
        <div class="flex items-center gap-3 bg-white/60 p-3 rounded-2xl border border-blue-100 mb-3 shadow-sm w-full max-w-[220px] md:max-w-xs transition-all hover:bg-white">
           <button class="audio-play-btn w-10 h-10 rounded-full bg-blue-600 text-white flex items-center justify-center flex-shrink-0 shadow-md hover:bg-blue-700 transition-colors">
              <svg class="play-icon" width="16" height="16" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
              <svg class="pause-icon hidden" width="16" height="16" fill="currentColor" viewBox="0 0 24 24"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg>
           </button>
           <div class="flex-1 flex flex-col gap-1 w-full overflow-hidden">
             <div class="w-full h-1.5 bg-blue-200 rounded-full overflow-hidden relative cursor-pointer" id="progress-container-${msgId}">
                <div class="audio-progress absolute left-0 top-0 h-full bg-blue-600 rounded-full w-0 pointer-events-none"></div>
             </div>
             <div class="flex justify-between w-full">
               <span class="audio-time text-[9px] font-bold text-blue-600">0:00</span>
               <span class="text-[9px] font-bold text-slate-400">Nota de Voz</span>
             </div>
           </div>
        </div>
      `;
    }

    div.innerHTML = `
      <div class="w-8 h-8 md:w-10 md:h-10 rounded-2xl ${isAi ? 'bg-[#001529] text-cyan-400' : 'bg-blue-600 text-white'} flex items-center justify-center shadow-md flex-shrink-0 relative z-0">
        ${isAi ? '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 8V4H8"/><rect width="16" height="12" x="4" y="8" rx="2"/><path d="M2 14h2"/><path d="M20 14h2"/><path d="M15 13v2"/><path d="M9 13v2"/></svg>' : '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>'}
      </div>
      <div class="space-y-2 ${isAi ? '' : 'text-right'} relative max-w-[85%] md:max-w-[75%]">
        <div class="bg-white border border-slate-200 p-4 md:p-6 rounded-[28px] ${isAi ? 'rounded-tl-none pt-7 md:pt-7' : 'rounded-tr-none bg-blue-50/50 pt-7 md:pt-7'} shadow-sm text-slate-700 text-sm relative transition-all group-hover:border-blue-300">
          
          <div class="absolute ${toolPosition} opacity-0 group-hover:opacity-100 transition-all duration-200 z-20">
            <div class="flex flex-row bg-white border border-slate-200 shadow-md rounded-xl p-0 gap-0.5">
              <button class="copy-msg p-0.5 ${isAi ? 'hover:bg-slate-100' : 'hover:bg-slate-50'} rounded-lg text-slate-400 hover:text-emerald-600 transition-colors">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
              </button>
              ${!isAi ? `
              <button class="edit-msg p-0.5 hover:bg-slate-50 rounded-lg text-slate-400 hover:text-blue-600 transition-colors" data-id="${msgId}">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 1 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
              </button>
              ` : ''}
            </div>
          </div>

          <p class="font-black text-[#001529] mb-2 uppercase text-[9px] tracking-widest text-left">${isAi ? 'Synapse Core AI' : 'Usuario'}</p>
          <div id="text-container-${msgId}">
            <div id="text-${msgId}" class="break-words leading-relaxed text-left ${isAi ? 'pr-8 text-slate-600' : 'text-slate-700'}">
              ${audioHtml}
              ${mediaHtml}
              ${audioData ? `<p class="text-[10px] text-slate-400 italic mb-1 uppercase font-bold tracking-wider mt-2">Transcripción:</p>` : ''}
              ${formattedText}
            </div>
          </div>
        </div>
      </div>
    `;

    // Botón Copiar
    div.querySelector('.copy-msg')?.addEventListener('click', () => {
      copyToClipboard(text, div.querySelector('.copy-msg'));
    });

    // Botón Editar
    if (!isAi) {
      div.querySelector('.edit-msg')?.addEventListener('click', () => {
        toggleEditMode(msgId);
      });
    }

    // Funcionalidad Real de Audio
    if (audioData) {
      const audioEl = div.querySelector(`#audio-el-${msgId}`) as HTMLAudioElement;
      const playBtn = div.querySelector('.audio-play-btn');
      const progressBar = div.querySelector('.audio-progress') as HTMLElement;
      const timeLabel = div.querySelector('.audio-time') as HTMLElement;
      const playIcon = div.querySelector('.play-icon');
      const pauseIcon = div.querySelector('.pause-icon');

      // Actualizar tiempo total al cargar
      audioEl.addEventListener('loadedmetadata', () => {
         timeLabel.innerText = formatTime(Math.floor(audioEl.duration));
      });

      playBtn?.addEventListener('click', () => {
        if (audioEl.paused) {
          audioEl.play();
          playIcon?.classList.add('hidden');
          pauseIcon?.classList.remove('hidden');
        } else {
          audioEl.pause();
          playIcon?.classList.remove('hidden');
          pauseIcon?.classList.add('hidden');
        }
      });

      audioEl.addEventListener('timeupdate', () => {
        const percent = (audioEl.currentTime / audioEl.duration) * 100;
        progressBar.style.width = `${percent}%`;
        timeLabel.innerText = formatTime(Math.floor(audioEl.currentTime));
      });

      audioEl.addEventListener('ended', () => {
        playIcon?.classList.remove('hidden');
        pauseIcon?.classList.add('hidden');
        progressBar.style.width = '0%';
        timeLabel.innerText = formatTime(Math.floor(audioEl.duration || 0));
      });
    }

    const imgElement = div.querySelector('img');
    if (imgElement) {
      imgElement.onload = scrollToBottom;
    }

    return div;
  }

  // EDICIÓN DE MENSAJES (Mantiene el texto limpio)
  function toggleEditMode(msgId) {
    const chat = chatHistory.find(c => c.id === currentChatId);
    const msg = chat.messages.find(m => m.id === msgId);
    const currentText = msg ? msg.text : "";
    const textContainer = document.getElementById(`text-container-${msgId}`);
    
    textContainer!.innerHTML = `
      <div class="flex flex-col gap-3 animate-in fade-in zoom-in-95 duration-200 mt-2">
        <textarea id="edit-input-${msgId}" class="w-full bg-white border-2 border-blue-500 rounded-xl p-3 text-sm focus:outline-none min-h-[80px] text-slate-700 font-medium">${currentText}</textarea>
        <div class="flex gap-2 justify-end">
          <button class="cancel-edit px-4 py-2 bg-slate-100 text-slate-500 rounded-lg text-[10px] font-black uppercase hover:bg-slate-200 transition-all">Cancelar</button>
          <button class="save-edit px-4 py-2 bg-blue-600 text-white rounded-lg text-[10px] font-black uppercase hover:bg-blue-700 transition-all shadow-md">Actualizar</button>
        </div>
      </div>
    `;

    textContainer!.querySelector('.cancel-edit')?.addEventListener('click', () => loadActiveChat());
    
    textContainer!.querySelector('.save-edit')?.addEventListener('click', async () => {
      const newText = (document.getElementById(`edit-input-${msgId}`) as HTMLTextAreaElement).value.trim();
      if (newText && newText !== currentText) {
        await processUpdate(msgId, newText);
      } else {
        loadActiveChat();
      }
    });
  }

  async function processUpdate(msgId, newText) {
    const chat = chatHistory.find(c => c.id === currentChatId);
    if (!chat) return;
    const userMsgIndex = chat.messages.findIndex(m => m.id === msgId);
    if (userMsgIndex === -1) return;
    chat.messages[userMsgIndex].text = newText;
    chat.messages = chat.messages.slice(0, userMsgIndex + 1);
    localStorage.setItem('synapse_history', JSON.stringify(chatHistory));
    loadActiveChat();
    const typingId = `typing-${Date.now()}`;
    showTyping(typingId);
    try {
      const aiResponse = await getAIResponse(newText, chat.messages[userMsgIndex].image);
      hideTyping(typingId);
      const aId = `a-${Date.now()}`;
      saveMessage('ai', aiResponse, aId);
      loadActiveChat();
    } catch (e) {
      hideTyping(typingId);
      saveMessage('ai', "[ERROR DE CONEXIÓN]", `err-${Date.now()}`);
      loadActiveChat();
    }
  }

  // ENVÍO DE FORMULARIO (Manejo inteligente de audio y texto)
  chatForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    
    let message = userInput.value.trim();
    let sentImage = currentImageData;
    let audioBase64 = null;

    if (isRecording) {
      audioBase64 = await stopRecording(false);
      message = audioTranscript.trim();
      
      // INTELIGENCIA LOCAL: Si el usuario mandó audio pero no dijo nada
      if (!message) {
         const aId = `a-${Date.now()}`;
         chatBox?.appendChild(createMessage("No logré identificar su voz en el audio. Por favor, verifique su micrófono o escriba su consulta en el panel de texto.", true, aId));
         scrollToBottom();
         return; 
      }
    }

    if (!message && !sentImage) return; 

    const uId = `u-${Date.now()}`;
    chatBox?.appendChild(createMessage(message, false, uId, sentImage, audioBase64));
    saveMessage('user', message, uId, sentImage, audioBase64);
    
    userInput.value = '';
    currentImageData = null;
    imgPreviewContainer?.classList.add('hidden');
    fileInput.value = '';
    cameraInput.value = '';
    scrollToBottom();
    
    const typingId = `typing-${Date.now()}`;
    showTyping(typingId);
    
    try {
      const aiResponse = await getAIResponse(message, sentImage);
      hideTyping(typingId);
      const aId = `a-${Date.now()}`;
      saveMessage('ai', aiResponse, aId);
      loadActiveChat(); 
    } catch (error) {
      hideTyping(typingId);
      saveMessage('ai', "[ERROR DE SISTEMA O CONEXIÓN]", `err-${Date.now()}`);
      loadActiveChat();
    }
  });

  // Modificamos guardado local para incluir Base64 del audio
  function saveMessage(role, text, id, image = null, audioData = null) {
    let chat = chatHistory.find(c => c.id === currentChatId);
    let chatTitle = text ? text.substring(0, 20).toUpperCase() + "..." : (audioData ? "NOTA DE VOZ" : "IMAGEN ADJUNTA");
    if (!chat) {
      chat = { id: currentChatId, title: chatTitle, messages: [], pinned: false };
      chatHistory.unshift(chat);
    }
    chat.messages.push({ role, text, id, image, audioData });
    localStorage.setItem('synapse_history', JSON.stringify(chatHistory));
    renderHistory();
  }

  function showTyping(id) {
    const typingDiv = document.createElement('div');
    typingDiv.id = id;
    typingDiv.className = "text-slate-400 text-[10px] font-bold uppercase tracking-widest animate-pulse ml-16 mb-4";
    typingDiv.innerText = "IA Procesando...";
    chatBox?.appendChild(typingDiv);
    scrollToBottom(); 
  }

  function hideTyping(id) {
    document.getElementById(id)?.remove();
  }

  async function copyToClipboard(text, btn) {
    try {
      await navigator.clipboard.writeText(text);
      const originalInner = btn.innerHTML;
      btn.innerHTML = '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="3"><polyline points="20 6 9 17 4 12"></polyline></svg>';
      setTimeout(() => { btn.innerHTML = originalInner; }, 2000);
    } catch (err) { console.error('Error al copiar:', err); }
  }

  // ==========================================
  // SIDEBAR & HISTORY
  // ==========================================
  function saveAndRefresh() {
    localStorage.setItem('synapse_history', JSON.stringify(chatHistory));
    localStorage.setItem('active_chat_id', currentChatId);
    renderHistory();
    loadActiveChat();
  }

  function renderHistory() {
    if (!chatList) return;
    const sortedHistory = [...chatHistory].sort((a, b) => (a.pinned === b.pinned ? 0 : a.pinned ? -1 : 1));
    chatList.innerHTML = sortedHistory.map(chat => `
      <div id="container-${chat.id}" class="group relative mb-2">
        <div class="relative flex items-center">
          <button class="chat-item w-full text-left p-4 pr-12 text-[10px] rounded-2xl transition-all truncate border font-black uppercase tracking-tighter flex items-center gap-2 ${chat.id === currentChatId ? 'bg-blue-600 text-white shadow-lg' : 'bg-white border-slate-100 text-slate-500 hover:border-blue-300'}" data-id="${chat.id}">
            ${chat.pinned ? `<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" class="flex-shrink-0 text-cyan-400"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>` : ''}
            <span class="truncate">${chat.title}</span>
          </button>
          <button class="options-trigger absolute right-3 p-2 text-current z-30 transition-colors hover:text-cyan-400" data-id="${chat.id}">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><circle cx="12" cy="12" r="1.5"/><circle cx="12" cy="19" r="1.5"/><circle cx="12" cy="5" r="1.5"/></svg>
          </button>
        </div>
        <div id="menu-${chat.id}" class="hidden absolute left-0 top-12 w-48 bg-white border border-slate-200 shadow-2xl rounded-2xl z-[100] py-2">
          <button class="rename-trigger w-full flex items-center gap-3 px-4 py-2.5 text-[10px] font-bold text-slate-600 hover:bg-slate-50" data-id="${chat.id}">CAMBIAR NOMBRE</button>
          <button class="pin-btn w-full flex items-center gap-3 px-4 py-2.5 text-[10px] font-bold text-slate-600 hover:bg-slate-50" data-id="${chat.id}">${chat.pinned ? 'DESFIJAR' : 'FIJAR CHAT'}</button>
          <button class="delete-trigger w-full flex items-center gap-3 px-4 py-2.5 text-[10px] font-bold text-red-500 hover:bg-red-50" data-id="${chat.id}">ELIMINAR</button>
        </div>
      </div>
    `).join('');
    attachActions();
  }

  function attachActions() {
    document.querySelectorAll('.chat-item').forEach(btn => {
      btn.addEventListener('click', () => {
        currentChatId = (btn as HTMLElement).dataset.id!;
        saveAndRefresh();
        if(window.innerWidth < 768) closeMenu();
      });
    });

    document.querySelectorAll('.options-trigger').forEach(trigger => {
      trigger.addEventListener('click', (e) => {
        e.stopPropagation();
        const id = (trigger as HTMLElement).dataset.id!;
        document.querySelectorAll('[id^="menu-"]').forEach(m => m.id !== `menu-${id}` && m.classList.add('hidden'));
        document.getElementById(`menu-${id}`)?.classList.toggle('hidden');
      });
    });

    document.querySelectorAll('.rename-trigger').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const id = (btn as HTMLElement).dataset.id!;
        const chat = chatHistory.find(c => c.id === id);
        const nuevo = prompt("NUEVO NOMBRE:", chat.title);
        if (nuevo) { chat.title = nuevo.toUpperCase(); saveAndRefresh(); }
      });
    });

    document.querySelectorAll('.pin-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const id = (btn as HTMLElement).dataset.id!;
        const chat = chatHistory.find(c => c.id === id);
        chat.pinned = !chat.pinned;
        saveAndRefresh();
      });
    });

    document.querySelectorAll('.delete-trigger').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        idToDelete = (btn as HTMLElement).dataset.id!;
        const chat = chatHistory.find(c => c.id === idToDelete);
        if (modalChatName) modalChatName.innerText = `"${chat.title}"`;
        deleteModal?.classList.replace('hidden', 'flex');
      });
    });
  }

  function openMenu() { sidebar?.classList.remove('-translate-x-full'); overlay?.classList.replace('hidden', 'block'); }
  function closeMenu() { sidebar?.classList.add('-translate-x-full'); overlay?.classList.replace('block', 'hidden'); }

  toggleSidebar?.addEventListener('click', () => {
    if (window.innerWidth >= 768) { sidebar?.classList.toggle('md:hidden'); } else { openMenu(); }
  });

  closeSidebar?.addEventListener('click', closeMenu);
  overlay?.addEventListener('click', closeMenu);

  newChatBtn?.addEventListener('click', () => {
    currentChatId = Date.now().toString();
    localStorage.setItem('active_chat_id', currentChatId);
    loadActiveChat();
    renderHistory();
    if(window.innerWidth < 768) closeMenu();
  });

  document.getElementById('cancel-delete')?.addEventListener('click', () => deleteModal?.classList.replace('flex', 'hidden'));
  document.getElementById('confirm-delete')?.addEventListener('click', () => {
    chatHistory = chatHistory.filter(c => c.id !== idToDelete);
    if (currentChatId === idToDelete) currentChatId = chatHistory.length > 0 ? chatHistory[0].id : Date.now().toString();
    deleteModal?.classList.replace('flex', 'hidden');
    saveAndRefresh();
  });

  window.onclick = () => document.querySelectorAll('[id^="menu-"]').forEach(m => m.classList.add('hidden'));

  function init() {
    renderHistory();
    loadActiveChat();
  }
  
  init();
</script>

<style>
  .custom-scrollbar::-webkit-scrollbar { width: 4px; }
  .custom-scrollbar::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 10px; }
  #chat-box { scroll-behavior: smooth; }
</style>