---
import Layout from '../layouts/MainLayout.astro';
import Navbar from '../components/shared/Navbar.astro';
import Footer from '../components/shared/Footer.astro';
import Contact from '../sections/Contact.astro'; // Tu componente actual de inicio
---

<Layout title="Contacto | Synapse Engineering">
  <Navbar />
  
  <div class="block md:hidden h-20"></div>
  
  <main>
    <section class="bg-[#001529] flex items-center h-[40vh] md:h-[50vh] pt-16 pb-12 md:pt-0 md:pb-0 border-b border-white/5 overflow-hidden">
      <div class="container mx-auto px-6">
        <h1 class="text-5xl md:text-7xl font-black text-white uppercase tracking-tighter leading-none mb-4">
          CONTACTO <span class="text-cyan-400 block md:inline">DIRECTO</span>
        </h1>
        
        <div class="h-2 w-24 bg-cyan-500 mt-6"></div>
        
        <p class="text-slate-300 mt-6 max-w-xl text-lg font-medium leading-relaxed">
          Ponte en contacto con nuestro equipo técnico para consultas sobre ingeniería 
          y fabricación de tableros.
        </p>
      </div>
    </section>

    <section class="bg-white">
      <Contact />
    </section>

    <section class="py-24 bg-slate-50">
      <div class="container mx-auto px-6 grid md:grid-cols-2 gap-12">
        <div class="bg-white p-2 rounded-3xl shadow-2xl border border-slate-100 overflow-hidden h-[450px]">
          <iframe 
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3901.8679075797374!2d-77.0601!3d-12.0464!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2zMTLCsDAyJzQ3LjAiUyA3N8KwMDMnMzYuNCJX!5e0!3m2!1ses!2spe!4v1700000000000" 
            class="w-full h-full rounded-2xl" 
            style="border:0;" 
            allowfullscreen="" 
            loading="lazy">
          </iframe>
        </div>
        
        <div class="flex flex-col justify-center">
            <h3 class="text-2xl font-black text-[#005596] uppercase mb-6">Oficinas Centrales</h3>
            <div class="space-y-6">
                <div class="flex gap-4 italic font-bold text-slate-600 uppercase text-sm">
                    <span class="text-cyan-500">DIRECCIÓN:</span> Calle Luis Carranza 2174, Lima
                </div>
                <div class="flex gap-4 italic font-bold text-slate-600 uppercase text-sm">
                    <span class="text-cyan-500">HORARIO:</span> Lun - Vie: 8:00 AM - 6:00 PM
                </div>
                <div class="flex gap-4 italic font-bold text-slate-600 uppercase text-sm">
                    <span class="text-cyan-500">CENTRAL:</span> (01) 971 444 230
                </div>
            </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>