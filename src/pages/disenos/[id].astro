---
import Layout from '../../layouts/MainLayout.astro';
import Navbar from '../../components/shared/Navbar.astro';
import Footer from '../../components/shared/Footer.astro';
import { ChevronLeft, List, Clock, ShieldCheck, Cpu } from 'lucide-react';

export const prerender = false;
const { id } = Astro.params;

const allDesigns: Record<string, any> = {
  "tdf-01": { title: "Tablero de distribución principal TDF-01", desc: "Recepción y distribución segura de energía con envolvente autosoportado de alta resistencia.", img: "https://images.unsplash.com/photo-1581092334651-ddf26d9a1930?auto=format&fit=crop&q=80", leadTime: "04-06 DÍAS", validation: "Norma IEC 61439-1", materials: [{ name: "Interruptores Termomagnéticos", qty: "4 ud." }, { name: "Barras de Cobre", qty: "1 set" }, { name: "Gabinete IP65", qty: "1 ud." }, { name: "Borneras", qty: "24 ud." }] },
  "jumbo-02": { title: "Tablero de distribución JUMBO", desc: "Alta capacidad - Jumbo Series para entornos industriales exigentes.", img: "https://images.unsplash.com/photo-1581092335397-9583ee92d0bb?auto=format&fit=crop&q=80", leadTime: "08-10 DÍAS", validation: "Certificación UL", materials: [{ name: "Interruptor Principal", qty: "1 ud." }, { name: "Relés de Protección", qty: "3 ud." }, { name: "Ventilación Forzada", qty: "2 ud." }, { name: "Cableado Control", qty: "100m" }] },
  "diseno-03": { title: "Diseño de Ingeniería 03", desc: "Solución técnica optimizada para procesos de alta demanda energética.", img: "https://images.unsplash.com/photo-1581092334651-ddf26d9a1930?auto=format&fit=crop&q=80", leadTime: "05 DÍAS", validation: "Norma IEC 61439-1", materials: [{ name: "PLC", qty: "1 ud." }, { name: "Módulos I/O", qty: "4 ud." }, { name: "Fuente Poder", qty: "1 ud." }, { name: "Switch Ind.", qty: "1 ud." }] },
  "diseno-04": { title: "Diseño de Ingeniería 04", desc: "Precisión milimétrica en el modelado de componentes eléctricos.", img: "https://images.unsplash.com/photo-1581092335397-9583ee92d0bb?auto=format&fit=crop&q=80", leadTime: "06 DÍAS", validation: "Estándar ANSI", materials: [{ name: "Contactores", qty: "6 ud." }, { name: "Fusibles", qty: "3 ud." }, { name: "Rieles DIN", qty: "2 ud." }, { name: "Canaletas", qty: "12m" }] },
  "diseno-05": { title: "Diseño de Ingeniería 05", desc: "Distribución eficiente para entornos de centros de control.", img: "https://images.unsplash.com/photo-1581092334651-ddf26d9a1930?auto=format&fit=crop&q=80", leadTime: "07 DÍAS", validation: "Norma IEC 61439-1", materials: [{ name: "Breakers", qty: "12 ud." }, { name: "Barra PE", qty: "1 ud." }, { name: "Luz Piloto", qty: "4 ud." }, { name: "Selectores", qty: "2 ud." }] },
  "diseno-06": { title: "Diseño de Ingeniería 06", desc: "Componentes de alta resistencia y durabilidad certificada.", img: "https://images.unsplash.com/photo-1581092335397-9583ee92d0bb?auto=format&fit=crop&q=80", leadTime: "09 DÍAS", validation: "Certificado CE", materials: [{ name: "Transformador", qty: "1 ud." }, { name: "Capacitores", qty: "3 ud." }, { name: "Filtros", qty: "2 ud." }, { name: "Sensores", qty: "5 ud." }] },
  "diseno-07": { title: "Diseño de Ingeniería 07", desc: "Integración de tableros con protocolos de seguridad avanzada.", img: "https://images.unsplash.com/photo-1581092334651-ddf26d9a1930?auto=format&fit=crop&q=80", leadTime: "12 DÍAS", validation: "IEC 61439-2", materials: [{ name: "Contactor Seguridad", qty: "2 ud." }, { name: "Bloque Aux.", qty: "4 ud." }, { name: "Pulsador EMO", qty: "1 ud." }, { name: "Fuente 24V", qty: "1 ud." }] },
  "diseno-08": { title: "Diseño de Ingeniería 08", desc: "Automatización aplicada para optimización de recursos.", img: "https://images.unsplash.com/photo-1581092335397-9583ee92d0bb?auto=format&fit=crop&q=80", leadTime: "10 DÍAS", validation: "Norma Técnica", materials: [{ name: "Variador VFD", qty: "1 ud." }, { name: "Resistencia", qty: "1 ud." }, { name: "Filtro EMI", qty: "1 ud." }, { name: "Ventilador", qty: "1 ud." }] },
  "diseno-09": { title: "Diseño de Ingeniería 09", desc: "Ingeniería de detalle en gabinetes de alta complejidad.", img: "https://images.unsplash.com/photo-1581092334651-ddf26d9a1930?auto=format&fit=crop&q=80", leadTime: "14 DÍAS", validation: "IEC 61439-1", materials: [{ name: "Barra Principal", qty: "3 ud." }, { name: "Soportes", qty: "12 ud." }, { name: "Aisladores", qty: "6 ud." }, { name: "Prensaestopas", qty: "8 ud." }] },
  "diseno-10": { title: "Diseño de Ingeniería 10", desc: "Eficiencia energética comprobada en cada componente.", img: "https://images.unsplash.com/photo-1581092335397-9583ee92d0bb?auto=format&fit=crop&q=80", leadTime: "05 DÍAS", validation: "Norma ISO", materials: [{ name: "Medidor Energía", qty: "1 ud." }, { name: "TCs", qty: "3 ud." }, { name: "Fusibles", qty: "3 ud." }, { name: "Borneras", qty: "10 ud." }] },
  "diseno-11": { title: "Diseño de Ingeniería 11", desc: "Robustez y diseño ergonómico para mantenimiento.", img: "https://images.unsplash.com/photo-1581092334651-ddf26d9a1930?auto=format&fit=crop&q=80", leadTime: "07 DÍAS", validation: "Cert. Calidad", materials: [{ name: "Puerta", qty: "1 ud." }, { name: "Bisagras", qty: "3 ud." }, { name: "Cerradura", qty: "1 ud." }, { name: "Junta", qty: "2m" }] },
  "diseno-12": { title: "Diseño de Ingeniería 12", desc: "Ingeniería avanzada para el sector minero industrial.", img: "https://images.unsplash.com/photo-1581092335397-9583ee92d0bb?auto=format&fit=crop&q=80", leadTime: "15 DÍAS", validation: "Norma MSHA", materials: [{ name: "Gabinete SS", qty: "1 ud." }, { name: "Calentador", qty: "1 ud." }, { name: "Termostato", qty: "1 ud." }, { name: "Luz", qty: "1 ud." }] },
  "diseno-13": { title: "Diseño de Ingeniería 13", desc: "Alta disponibilidad para infraestructuras críticas.", img: "https://images.unsplash.com/photo-1581092334651-ddf26d9a1930?auto=format&fit=crop&q=80", leadTime: "11 DÍAS", validation: "IEC 61439-1", materials: [{ name: "ATS", qty: "1 ud." }, { name: "Controlador", qty: "1 ud." }, { name: "Breaker", qty: "2 ud." }, { name: "Cables", qty: "20m" }] },
  "diseno-14": { title: "Diseño de Ingeniería 14", desc: "Innovación aplicada en gabinetes eléctricos modernos.", img: "https://images.unsplash.com/photo-1581092335397-9583ee92d0bb?auto=format&fit=crop&q=80", leadTime: "08 DÍAS", validation: "Certificación UL", materials: [{ name: "Panel Táctil", qty: "1 ud." }, { name: "PLC", qty: "1 ud." }, { name: "Módulos", qty: "4 ud." }, { name: "Fuente", qty: "1 ud." }] },
  "diseno-15": { title: "Diseño de Ingeniería 15", desc: "Cumplimiento estricto con normativas internacionales.", img: "https://images.unsplash.com/photo-1581092334651-ddf26d9a1930?auto=format&fit=crop&q=80", leadTime: "06 DÍAS", validation: "IEC 61439-2", materials: [{ name: "Seccionador", qty: "1 ud." }, { name: "Fusibles", qty: "3 ud." }, { name: "Carcasa", qty: "1 ud." }, { name: "Base", qty: "1 ud." }] },
  "diseno-16": { title: "Diseño de Ingeniería 16", desc: "Soluciones a medida para entornos de gran escala.", img: "https://images.unsplash.com/photo-1581092335397-9583ee92d0bb?auto=format&fit=crop&q=80", leadTime: "20 DÍAS", validation: "Norma ISO", materials: [{ name: "Barra Cobre", qty: "6 ud." }, { name: "Aisladores", qty: "12 ud." }, { name: "Soportes", qty: "6 ud." }, { name: "Tornillos", qty: "40 ud." }] },
  "diseno-17": { title: "Diseño de Ingeniería 17", desc: "Calidad certificada y diseño de precisión.", img: "https://images.unsplash.com/photo-1581092334651-ddf26d9a1930?auto=format&fit=crop&q=80", leadTime: "04 DÍAS", validation: "Cert. Calidad", materials: [{ name: "Relevador", qty: "4 ud." }, { name: "Zócalos", qty: "4 ud." }, { name: "Etiquetas", qty: "1 set" }, { name: "Canaletas", qty: "5m" }] },
  "diseno-18": { title: "Diseño de Ingeniería 18", desc: "Distribución de energía optimizada y segura.", img: "https://images.unsplash.com/photo-1581092335397-9583ee92d0bb?auto=format&fit=crop&q=80", leadTime: "09 DÍAS", validation: "IEC 61439-1", materials: [{ name: "Breaker", qty: "8 ud." }, { name: "Barra", qty: "1 ud." }, { name: "Bornera", qty: "16 ud." }, { name: "Tapa", qty: "1 ud." }] },
  "diseno-19": { title: "Diseño de Ingeniería 19", desc: "Tecnología de punta en automatización.", img: "https://images.unsplash.com/photo-1581092334651-ddf26d9a1930?auto=format&fit=crop&q=80", leadTime: "13 DÍAS", validation: "Norma Técnica", materials: [{ name: "HMI", qty: "1 ud." }, { name: "Cable", qty: "5m" }, { name: "Fuente", qty: "1 ud." }, { name: "Batería", qty: "1 ud." }] },
  "diseno-20": { title: "Diseño de Ingeniería 20", desc: "Precisión máxima para resultados garantizados.", img: "https://images.unsplash.com/photo-1581092335397-9583ee92d0bb?auto=format&fit=crop&q=80", leadTime: "07 DÍAS", validation: "Estándar ANSI", materials: [{ name: "Interruptor", qty: "2 ud." }, { name: "Relé", qty: "2 ud." }, { name: "Filtro", qty: "1 ud." }, { name: "Luz", qty: "2 ud." }] }
};

const design = allDesigns[id as string] || allDesigns["tdf-01"];
const titleParts = design.title.split(' ');
const lastWord = titleParts.pop();
const mainTitle = titleParts.join(' ');
---

<Layout title={`${design.title} | Synapse Engineering`}>
  <Navbar />
  <main class="bg-white min-h-screen pt-32 pb-20">
    <div class="container mx-auto px-6">
      <a href="/disenos" class="inline-flex items-center gap-2 text-[#001529] hover:text-cyan-600 transition-all font-black text-[11px] uppercase tracking-[0.2em] mb-8 group">
        <ChevronLeft size={20} class="group-hover:-translate-x-1 transition-transform" /> 
        Volver a diseños
      </a>
      <div class="max-w-4xl mb-12 space-y-4">
        <h1 class="text-4xl md:text-6xl font-black text-[#001529] uppercase tracking-tighter leading-none">
            {mainTitle} <span class="text-cyan-500">{lastWord}</span>
        </h1>
        <p class="text-slate-500 text-xl font-medium leading-relaxed italic border-l-4 border-cyan-500 pl-6 max-w-3xl">
          "{design.desc}"
        </p>
      </div>
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
        <div class="lg:col-span-8 space-y-6">
          <div class="bg-slate-50 border border-slate-200 rounded-[32px] p-8 md:p-12 flex items-center justify-center min-h-[500px] shadow-sm overflow-hidden group">
            <img src={design.img} class="max-h-[550px] object-contain transition-transform duration-700 group-hover:scale-105" alt={design.title} />
          </div>
          <button class="w-full lg:w-max bg-cyan-500 hover:bg-[#001529] text-white font-black px-12 py-5 rounded-xl flex items-center justify-center gap-3 uppercase tracking-widest transition-all hover:scale-[1.02] active:scale-95 shadow-xl shadow-cyan-500/20 group">
            <Cpu size={20} class="group-hover:rotate-12 transition-transform" /> Ver modelo 3D interactivo
          </button>
        </div>
        <div class="lg:col-span-4 space-y-6">
          <div class="bg-[#0b1426] rounded-[32px] p-8 shadow-2xl overflow-hidden relative">
            <h2 class="text-white text-2xl font-black uppercase tracking-tight mb-8 relative z-10">Especificaciones</h2>
            <div class="space-y-3 relative z-10">
              {design.materials.map((m: any) => (
                <div class="flex justify-between items-center bg-white/5 p-4 rounded-2xl border border-white/10 hover:border-cyan-500/50 hover:bg-white/10 transition-all group">
                    <span class="text-[10px] text-slate-300 font-bold uppercase group-hover:text-white transition-colors tracking-tight">{m.name}</span>
                    <span class="text-[10px] text-cyan-400 font-black bg-cyan-400/10 px-3 py-1 rounded-lg group-hover:bg-cyan-400 group-hover:text-[#0b1426] transition-all">{m.qty}</span>
                </div>
              ))}
            </div>
          </div>
          <div class="bg-slate-50 p-8 rounded-[32px] border border-slate-200 relative overflow-hidden group shadow-sm">
              <div class="flex items-center gap-3 text-[#001529]/60 mb-3">
                  <Clock size={18} />
                  <span class="text-[10px] font-black uppercase tracking-widest">Entrega Estimada</span>
              </div>
              <p class="text-3xl font-black text-[#001529] italic uppercase tracking-tighter">{design.leadTime}</p>
              <Clock size={80} class="absolute -right-4 -bottom-4 text-slate-200 group-hover:text-cyan-500/10 group-hover:rotate-12 transition-all duration-500" />
          </div>
          <div class="flex items-center gap-3 text-[#001529]/40 px-4 group">
              <ShieldCheck size={20} class="group-hover:text-cyan-500 transition-colors" />
              <span class="text-[11px] font-bold italic tracking-wide uppercase group-hover:text-[#001529] transition-colors">{design.validation}</span>
          </div>
        </div>
      </div>
    </div>
  </main>
  <Footer />
</Layout>