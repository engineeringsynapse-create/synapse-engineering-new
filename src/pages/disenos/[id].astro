---
import Layout from '../../layouts/MainLayout.astro';
import Navbar from '../../components/shared/Navbar.astro';
import Footer from '../../components/shared/Footer.astro';
import { ChevronLeft, Clock, ShieldCheck, Cpu, Box } from 'lucide-react';

export const prerender = false;
const { id } = Astro.params;

const allDesigns: Record<string, any> = {
  "tdf-01": { title: "Tablero de distribución principal TDF-01", desc: "Recepción y distribución segura de energía con envolvente autosoportado de alta resistencia.", img: "/images/tablero1.png", model: "/models/tablero1.glb", leadTime: "04-06 DÍAS", validation: "Norma IEC 61439-1", materials: [{ name: "Interruptores Termomagnéticos", qty: "4 ud." }, { name: "Barras de Cobre", qty: "1 set" }, { name: "Gabinete IP65", qty: "1 ud." }, { name: "Borneras", qty: "24 ud." }] },
  "jumbo-02": { title: "Tablero de distribución JUMBO", desc: "Alta capacidad - Jumbo Series para entornos industriales exigentes.", img: "/images/tablero2.png", model: "/models/tablero2.glb", leadTime: "08-10 DÍAS", validation: "Certificación UL", materials: [{ name: "Interruptor Principal", qty: "1 ud." }, { name: "Relés de Protección", qty: "3 ud." }, { name: "Ventilación Forzada", qty: "2 ud." }, { name: "Cableado Control", qty: "100m" }] },
  "diseno-03": { title: "Diseño de Ingeniería 03", desc: "Solución técnica optimizada para procesos de alta demanda energética.", img: "/images/tablero3.png", model: "/models/tablero3.glb", leadTime: "05 DÍAS", validation: "Norma IEC 61439-1", materials: [{ name: "PLC", qty: "1 ud." }, { name: "Módulos I/O", qty: "4 ud." }, { name: "Fuente Poder", qty: "1 ud." }, { name: "Switch Ind.", qty: "1 ud." }] },
  "diseno-04": { title: "Diseño de Ingeniería 04", desc: "Precisión milimétrica en el modelado de componentes eléctricos.", img: "/images/tablero4.png", model: "/models/tablero4.glb", leadTime: "06 DÍAS", validation: "Estándar ANSI", materials: [{ name: "Contactores", qty: "6 ud." }, { name: "Fusibles", qty: "3 ud." }, { name: "Rieles DIN", qty: "2 ud." }, { name: "Canaletas", qty: "12m" }] },
  "diseno-05": { title: "Diseño de Ingeniería 05", desc: "Distribución eficiente para entornos de centros de control.", img: "/images/tablero5.png", model: "/models/tablero5.glb", leadTime: "07 DÍAS", validation: "Norma IEC 61439-1", materials: [{ name: "Breakers", qty: "12 ud." }, { name: "Barra PE", qty: "1 ud." }, { name: "Luz Piloto", qty: "4 ud." }, { name: "Selectores", qty: "2 ud." }] },
  "diseno-06": { title: "Diseño de Ingeniería 06", desc: "Componentes de alta resistencia y durabilidad certificada.", img: "/images/tablero6.png", model: "/models/tablero6.glb", leadTime: "09 DÍAS", validation: "Certificado CE", materials: [{ name: "Transformador", qty: "1 ud." }, { name: "Capacitores", qty: "3 ud." }, { name: "Filtros", qty: "2 ud." }, { name: "Sensores", qty: "5 ud." }] },
  "diseno-07": { title: "Diseño de Ingeniería 07", desc: "Integración de tableros con protocolos de seguridad avanzada.", img: "/images/tablero7.png", model: "/models/tablero7.glb", leadTime: "12 DÍAS", validation: "IEC 61439-2", materials: [{ name: "Contactor Seguridad", qty: "2 ud." }, { name: "Bloque Aux.", qty: "4 ud." }, { name: "Pulsador EMO", qty: "1 ud." }, { name: "Fuente 24V", qty: "1 ud." }] },
  "diseno-08": { title: "Diseño de Ingeniería 08", desc: "Automatización aplicada para optimización de recursos.", img: "/images/tablero8.png", model: "/models/tablero8.glb", leadTime: "10 DÍAS", validation: "Norma Técnica", materials: [{ name: "Variador VFD", qty: "1 ud." }, { name: "Resistencia", qty: "1 ud." }, { name: "Filtro EMI", qty: "1 ud." }, { name: "Ventilador", qty: "1 ud." }] },
  "diseno-09": { title: "Diseño de Ingeniería 09", desc: "Ingeniería de detalle en gabinetes de alta complejidad.", img: "/images/tablero9.png", model: "/models/tablero9.glb", leadTime: "14 DÍAS", validation: "IEC 61439-1", materials: [{ name: "Barra Principal", qty: "3 ud." }, { name: "Soportes", qty: "12 ud." }, { name: "Aisladores", qty: "6 ud." }, { name: "Prensaestopas", qty: "8 ud." }] },
  "diseno-10": { title: "Diseño de Ingeniería 10", desc: "Eficiencia energética comprobada en cada componente.", img: "/images/tablero10.png", model: "/models/tablero10.glb", leadTime: "05 DÍAS", validation: "Norma ISO", materials: [{ name: "Medidor Energía", qty: "1 ud." }, { name: "TCs", qty: "3 ud." }, { name: "Fusibles", qty: "3 ud." }, { name: "Borneras", qty: "10 ud." }] },
  "diseno-11": { title: "Diseño de Ingeniería 11", desc: "Robustez y diseño ergonómico para mantenimiento.", img: "/images/tablero11.png", model: "/models/tablero11.glb", leadTime: "07 DÍAS", validation: "Cert. Calidad", materials: [{ name: "Puerta", qty: "1 ud." }, { name: "Bisagras", qty: "3 ud." }, { name: "Cerradura", qty: "1 ud." }, { name: "Junta", qty: "2m" }] },
  "diseno-12": { title: "Diseño de Ingeniería 12", desc: "Ingeniería avanzada para el sector minero industrial.", img: "/images/tablero12.png", model: "/models/tablero12.glb", leadTime: "15 DÍAS", validation: "Norma MSHA", materials: [{ name: "Gabinete SS", qty: "1 ud." }, { name: "Calentador", qty: "1 ud." }, { name: "Termostato", qty: "1 ud." }, { name: "Luz", qty: "1 ud." }] },
  "diseno-13": { title: "Diseño de Ingeniería 13", desc: "Alta disponibilidad para infraestructuras críticas.", img: "/images/tablero13.png", model: "/models/tablero13.glb", leadTime: "11 DÍAS", validation: "IEC 61439-1", materials: [{ name: "ATS", qty: "1 ud." }, { name: "Controlador", qty: "1 ud." }, { name: "Breaker", qty: "2 ud." }, { name: "Cables", qty: "20m" }] },
  "diseno-14": { title: "Diseño de Ingeniería 14", desc: "Innovación aplicada en gabinetes eléctricos modernos.", img: "/images/tablero14.png", model: "/models/tablero14.glb", leadTime: "08 DÍAS", validation: "Certificación UL", materials: [{ name: "Panel Táctil", qty: "1 ud." }, { name: "PLC", qty: "1 ud." }, { name: "Módulos", qty: "4 ud." }, { name: "Fuente", qty: "1 ud." }] },
  "diseno-15": { title: "Diseño de Ingeniería 15", desc: "Cumplimiento estricto con normativas internacionales.", img: "/images/tablero15.png", model: "/models/tablero15.glb", leadTime: "06 DÍAS", validation: "IEC 61439-2", materials: [{ name: "Seccionador", qty: "1 ud." }, { name: "Fusibles", qty: "3 ud." }, { name: "Carcasa", qty: "1 ud." }, { name: "Base", qty: "1 ud." }] },
  "diseno-16": { title: "Diseño de Ingeniería 16", desc: "Soluciones a medida para entornos de gran escala.", img: "/images/tablero16.png", model: "/models/tablero16.glb", leadTime: "20 DÍAS", validation: "Norma ISO", materials: [{ name: "Barra Cobre", qty: "6 ud." }, { name: "Aisladores", qty: "12 ud." }, { name: "Soportes", qty: "6 ud." }, { name: "Tornillos", qty: "40 ud." }] },
  "diseno-17": { title: "Diseño de Ingeniería 17", desc: "Calidad certificada y diseño de precisión.", img: "/images/tablero17.png", model: "/models/tablero17.glb", leadTime: "04 DÍAS", validation: "Cert. Calidad", materials: [{ name: "Relevador", qty: "4 ud." }, { name: "Zócalos", qty: "4 ud." }, { name: "Etiquetas", qty: "1 set" }, { name: "Canaletas", qty: "5m" }] },
  "diseno-18": { title: "Diseño de Ingeniería 18", desc: "Distribución de energía optimizada y segura.", img: "/images/tablero18.png", model: "/models/tablero18.glb", leadTime: "09 DÍAS", validation: "IEC 61439-1", materials: [{ name: "Breaker", qty: "8 ud." }, { name: "Barra", qty: "1 ud." }, { name: "Bornera", qty: "16 ud." }, { name: "Tapa", qty: "1 ud." }] },
  "diseno-19": { title: "Diseño de Ingeniería 19", desc: "Tecnología de punta en automatización.", img: "/images/tablero19.png", model: "/models/tablero19.glb", leadTime: "13 DÍAS", validation: "Norma Técnica", materials: [{ name: "HMI", qty: "1 ud." }, { name: "Cable", qty: "5m" }, { name: "Fuente", qty: "1 ud." }, { name: "Batería", qty: "1 ud." }] },
  "diseno-20": { title: "Diseño de Ingeniería 20", desc: "Precisión máxima para resultados garantizados.", img: "/images/tablero20.png", model: "/models/tablero20.glb", leadTime: "07 DÍAS", validation: "Estándar ANSI", materials: [{ name: "Interruptor", qty: "2 ud." }, { name: "Relé", qty: "2 ud." }, { name: "Filtro", qty: "1 ud." }, { name: "Luz", qty: "2 ud." }] }
};

const design = allDesigns[id as string] || allDesigns["tdf-01"];
const titleParts = design.title.split(' ');
const lastWord = titleParts.pop();
const mainTitle = titleParts.join(' ');
---

<Layout title={`${design.title} | Synapse Engineering`}>
  <Navbar />
  
  <main class="bg-white min-h-screen pt-32 pb-20">
    <div class="container mx-auto px-6">
      <a href="/disenos" class="inline-flex items-center gap-2 text-[#001529] hover:text-cyan-600 transition-all font-black text-[11px] uppercase tracking-[0.2em] mb-8 group">
        <ChevronLeft size={20} class="group-hover:-translate-x-1 transition-transform" /> 
        Volver a diseños
      </a>
      
      <div class="max-w-4xl mb-12 space-y-4">
        <h1 class="text-4xl md:text-6xl font-black text-[#001529] uppercase tracking-tighter leading-none">
            {mainTitle} <span class="text-cyan-500">{lastWord}</span>
        </h1>
        <p class="text-slate-500 text-xl font-medium leading-relaxed italic border-l-4 border-cyan-500 pl-6 max-w-3xl">
          "{design.desc}"
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
        <div class="lg:col-span-8 space-y-6">
          <div id="visualizador-container" class="bg-slate-50 border border-slate-200 rounded-[32px] p-2 flex items-center justify-center min-h-[500px] shadow-sm overflow-hidden relative">
            <img id="img-diseno" src={design.img} class="max-h-[550px] object-contain transition-transform duration-700 w-full" alt={design.title} />
            
            <div id="model-wrapper" class="w-full h-[550px]" style="display: none;">
                <model-viewer 
                  id="model-viewer"
                  src={design.model}
                  alt="Modelo 3D"
                  auto-rotate 
                  camera-controls 
                  shadow-intensity="0"
                  interaction-prompt="none"
                  style="width: 100%; height: 100%; background-color: #f8fafc;"
                ></model-viewer>
            </div>

            <div id="toolbar-3d" class="absolute bottom-4 left-1/2 -translate-x-1/2 bg-white/90 backdrop-blur p-2 rounded-xl border border-slate-200 shadow-xl flex gap-2" style="display: none;">
              <button onclick="setCamera('0deg 90deg 2m')" class="px-3 py-1.5 text-[10px] font-black uppercase hover:bg-cyan-500 hover:text-white rounded-lg transition-all">Frontal</button>
              <button onclick="setCamera('90deg 90deg 2m')" class="px-3 py-1.5 text-[10px] font-black uppercase hover:bg-cyan-500 hover:text-white rounded-lg transition-all">Lateral</button>
              <button onclick="setCamera('0deg 0deg 2m')" class="px-3 py-1.5 text-[10px] font-black uppercase hover:bg-cyan-500 hover:text-white rounded-lg transition-all">Superior</button>
              <button onclick="setCamera('45deg 45deg 2m')" class="px-3 py-1.5 text-[10px] font-black uppercase hover:bg-cyan-500 hover:text-white rounded-lg transition-all">Iso</button>
            </div>
          </div>
          
          <button id="btn-toggle" class="w-full lg:w-max bg-cyan-500 hover:bg-[#001529] text-white font-black px-12 py-5 rounded-xl flex items-center justify-center gap-3 uppercase tracking-widest transition-all hover:scale-[1.02] active:scale-95 shadow-xl shadow-cyan-500/20 group">
            <Box size={20} /> 
            <span id="btn-text">Ver modelo 3D interactivo</span>
          </button>
        </div>

        <div class="lg:col-span-4 space-y-6">
            <div class="bg-[#0b1426] rounded-[32px] p-8 shadow-2xl overflow-hidden relative">
            <h2 class="text-white text-2xl font-black uppercase tracking-tight mb-8 relative z-10">Especificaciones</h2>
            <div class="space-y-3 relative z-10">
              {design.materials.map((m: any) => (
                <div class="flex justify-between items-center bg-white/5 p-4 rounded-2xl border border-white/10 hover:border-cyan-500/50 hover:bg-white/10 transition-all group">
                    <span class="text-[10px] text-slate-300 font-bold uppercase group-hover:text-white transition-colors tracking-tight">{m.name}</span>
                    <span class="text-[10px] text-cyan-400 font-black bg-cyan-400/10 px-3 py-1 rounded-lg group-hover:bg-cyan-400 group-hover:text-[#0b1426] transition-all">{m.qty}</span>
                </div>
              ))}
            </div>
          </div>
          <div class="bg-slate-50 p-8 rounded-[32px] border border-slate-200 relative overflow-hidden group shadow-sm">
              <div class="flex items-center gap-3 text-[#001529]/60 mb-3">
                  <Clock size={18} />
                  <span class="text-[10px] font-black uppercase tracking-widest">Entrega Estimada</span>
              </div>
              <p class="text-3xl font-black text-[#001529] italic uppercase tracking-tighter">{design.leadTime}</p>
          </div>
          <div class="flex items-center gap-3 text-[#001529]/40 px-4 group">
              <ShieldCheck size={20} />
              <span class="text-[11px] font-bold italic tracking-wide uppercase">{design.validation}</span>
          </div>
        </div>
      </div>
    </div>
  </main>
  
  <script is:inline>
    const btn = document.getElementById('btn-toggle');
    const img = document.getElementById('img-diseno');
    const wrapper = document.getElementById('model-wrapper');
    const model = document.getElementById('model-viewer');
    const toolbar = document.getElementById('toolbar-3d');
    const btnText = document.getElementById('btn-text');
    let is3D = false;

    btn.addEventListener('click', () => {
      is3D = !is3D;
      img.style.display = is3D ? 'none' : 'block';
      wrapper.style.display = is3D ? 'block' : 'none';
      toolbar.style.display = is3D ? 'flex' : 'none';
      btnText.innerText = is3D ? 'Ver imagen técnica' : 'Ver modelo 3D interactivo';
    });

    function setCamera(pos) {
      if (model) model.cameraOrbit = pos;
    }
  </script>

  <Footer />
</Layout>