---
import { Briefcase, Award, ThumbsUp, Headset } from 'lucide-react';

const stats = [
  { label: "Proyectos Ejecutados", value: "+500", icon: Briefcase },
  { label: "Años de Experiencia", value: "10", icon: Award },
  { label: "Clientes Satisfechos", value: "100%", icon: ThumbsUp },
  { label: "Soporte Técnico", value: "24/7", icon: Headset }
];
---

<!-- Redujimos drásticamente el padding superior (pt-2 md:pt-4) para equilibrar el espacio extra que deja la sección de arriba -->
<section class="relative pt-2 pb-16 md:pt-4 md:pb-24 bg-white overflow-hidden">
  
  <div class="container mx-auto px-4 md:px-6 relative z-10">
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 md:gap-6">
      {stats.map((stat) => {
        const Icon = stat.icon;
        return (
          <div class="group relative bg-white border border-slate-100 rounded-3xl p-6 md:p-8 flex flex-col items-center justify-center text-center transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:shadow-blue-900/5 cursor-default">
            
            <!-- Contenedor del Icono: Estilo Premium exacto a tu referencia -->
            <div class="relative mb-6 z-10">
              <!-- Fondo celeste nativo de Tailwind para garantizar que compile -->
              <div class="w-14 h-14 md:w-16 md:h-16 flex items-center justify-center rounded-2xl bg-blue-50 group-hover:bg-blue-100 transition-colors duration-300">
                <!-- Icono azul vibrante con trazo grueso -->
                <Icon strokeWidth={2.5} size={28} class="text-blue-600 transition-transform duration-300 group-hover:scale-110" />
              </div>
            </div>

            <!-- Número -->
            <div class="text-3xl md:text-5xl font-black text-slate-900 mb-2 tracking-tighter">
              {stat.value}
            </div>

            <!-- Etiqueta -->
            <div class="text-slate-500 text-[10px] md:text-xs font-bold uppercase tracking-[0.15em] md:tracking-[0.2em]">
              {stat.label}
            </div>
            
          </div>
        );
      })}
    </div>
  </div>
</section>