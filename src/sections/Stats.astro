---
import { Briefcase, Award, ThumbsUp, Headset } from 'lucide-react';

const stats = [
  { label: "Proyectos Ejecutados", value: "+500", icon: Briefcase },
  { label: "Años de Experiencia", value: "10", icon: Award },
  { label: "Clientes Satisfechos", value: "100%", icon: ThumbsUp },
  { label: "Soporte Técnico", value: "24/7", icon: Headset }
];
---

<!-- Ajustamos pt-4 y md:pt-8 para quitar el exceso de aire arriba -->
<section class="relative pt-4 pb-16 md:pt-8 md:pb-24 bg-white overflow-hidden">
  <!-- Fondo Tecnológico (Malla sutil corporativa) -->
  <div class="absolute inset-0 z-0 pointer-events-none flex justify-center items-center">
    <div class="absolute inset-0 opacity-[0.03]" style="background-image: radial-gradient(#003d6b 1px, transparent 1px); background-size: 32px 32px;"></div>
  </div>

  <div class="container mx-auto px-4 md:px-6 relative z-10">
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 md:gap-6">
      {stats.map((stat) => {
        const Icon = stat.icon;
        return (
          <!-- Tarjeta con contraste (slate-50/100) en lugar de blanco puro -->
          <div class="group relative bg-gradient-to-b from-slate-50 to-slate-100/80 border border-slate-200 rounded-2xl p-5 md:p-8 flex flex-col items-center justify-center text-center transition-all duration-500 hover:-translate-y-1.5 hover:shadow-xl hover:shadow-[#003d6b]/10 cursor-default overflow-hidden">
            
            <!-- Línea LED difuminada que se enciende al hover -->
            <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-transparent via-cyan-400 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-700 z-20"></div>

            <!-- Capa de interacción azul sutil -->
            <div class="absolute inset-0 bg-[#005596]/[0.02] opacity-0 group-hover:opacity-100 transition-opacity duration-500 z-0"></div>

            <!-- Contenedor del Icono (Micro-tarjeta blanca para dar profundidad 3D) -->
            <div class="relative mb-4 md:mb-6 z-10">
              <div class="p-3 md:p-4 rounded-xl bg-white border border-slate-100 shadow-sm group-hover:border-cyan-100 group-hover:shadow-md group-hover:shadow-cyan-400/20 transition-all duration-500">
                <Icon strokeWidth={1.5} class="text-[#005596] w-6 h-6 md:w-8 md:h-8 transition-transform duration-500 group-hover:scale-110 group-hover:text-cyan-500" />
              </div>
            </div>

            <!-- Número corporativo -->
            <div class="text-3xl md:text-5xl font-black text-[#003d6b] mb-1.5 md:mb-2 tracking-tighter relative z-10 drop-shadow-sm">
              {stat.value}
            </div>

            <!-- Etiqueta refinada -->
            <div class="text-slate-500 group-hover:text-[#003d6b] text-[9px] md:text-xs font-bold uppercase tracking-[0.15em] md:tracking-[0.2em] transition-colors duration-300 relative z-10">
              {stat.label}
            </div>
            
          </div>
        );
      })}
    </div>
  </div>
</section>