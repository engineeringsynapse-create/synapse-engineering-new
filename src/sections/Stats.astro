---
import { Briefcase, Award, ThumbsUp, Headset } from 'lucide-react';

const stats = [
  { label: "Proyectos Ejecutados", value: "+500", icon: Briefcase },
  { label: "Años de Experiencia", value: "10", icon: Award },
  { label: "Clientes Satisfechos", value: "100%", icon: ThumbsUp },
  { label: "Soporte Técnico", value: "24/7", icon: Headset }
];
---

<!-- Simetría perfecta: py-12 en móvil, py-16 en escritorio (mismo aire arriba y abajo) -->
<section class="relative py-12 md:py-16 bg-white overflow-hidden">
  <!-- Fondo Tecnológico (Malla sutil corporativa) -->
  <div class="absolute inset-0 z-0 pointer-events-none flex justify-center items-center">
    <div class="absolute inset-0 opacity-[0.03]" style="background-image: radial-gradient(#003d6b 1px, transparent 1px); background-size: 32px 32px;"></div>
  </div>

  <div class="container mx-auto px-4 md:px-6 relative z-10">
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 md:gap-6">
      {stats.map((stat) => {
        const Icon = stat.icon;
        return (
          <!-- Tarjetas súper limpias y sutiles -->
          <div class="group relative bg-slate-50/50 hover:bg-white border border-slate-100 rounded-2xl p-6 md:p-8 flex flex-col items-center justify-center text-center transition-all duration-500 hover:-translate-y-1 hover:shadow-xl hover:shadow-[#003d6b]/5 cursor-default overflow-hidden">
            
            <!-- Línea LED difuminada que se enciende al hover (detalle premium) -->
            <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-transparent via-[#005596] to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-700 z-20"></div>

            <!-- Contenedor del Icono (Estilo exacto de tu referencia) -->
            <div class="relative mb-5 z-10">
              <!-- Fondo celeste muy suave, esquinas redondeadas, sin bordes duros -->
              <div class="w-14 h-14 md:w-16 md:h-16 flex items-center justify-center rounded-2xl bg-[#f4f7fb] group-hover:bg-[#e6eff8] transition-colors duration-500">
                <!-- Icono azul vibrante con trazo un poco más grueso (strokeWidth={2}) -->
                <Icon strokeWidth={2} class="text-[#005596] w-7 h-7 md:w-8 md:h-8 transition-transform duration-500 group-hover:scale-110" />
              </div>
            </div>

            <!-- Número corporativo -->
            <div class="text-3xl md:text-5xl font-black text-[#003d6b] mb-1.5 md:mb-2 tracking-tighter relative z-10 drop-shadow-sm">
              {stat.value}
            </div>

            <!-- Etiqueta refinada -->
            <div class="text-slate-500 group-hover:text-[#003d6b] text-[9px] md:text-xs font-bold uppercase tracking-[0.15em] md:tracking-[0.2em] transition-colors duration-300 relative z-10">
              {stat.label}
            </div>
            
          </div>
        );
      })}
    </div>
  </div>
</section>