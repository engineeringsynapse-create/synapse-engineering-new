---
import { ShieldCheck, HardHat, Factory, Microscope } from 'lucide-react';

const features = [
  {
    title: "Fabricación Propia",
    desc: "Planta equipada con tecnología CNC para el mecanizado de estructuras y barras de cobre.",
    icon: Factory,
    color: "bg-blue-600"
  },
  {
    title: "Protocolos FAT",
    desc: "Pruebas de aceptación en fábrica exhaustivas antes de cada despacho garantizado.",
    icon: ShieldCheck,
    color: "bg-slate-900"
  },
  {
    title: "Ingeniería 3D",
    desc: "Modelado detallado de ruteo de cables y disposición de componentes para mantenimiento fácil.",
    icon: Microscope,
    color: "bg-blue-600"
  },
  {
    title: "Servicio en Sitio",
    desc: "Montaje, comisionamiento y puesta en marcha en cualquier punto del territorio nacional.",
    icon: HardHat,
    color: "bg-slate-900"
  }
];
---

<section class="py-24 bg-white relative">
  <div class="container mx-auto px-6">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-0 border border-slate-100 rounded-3xl overflow-hidden shadow-2xl shadow-slate-200/50">
      {features.map((f) => (
        <div class="p-10 hover:bg-slate-50 transition-colors border-r border-b border-slate-100 last:border-r-0">
          <div class={`${f.color} w-12 h-12 rounded-lg flex items-center justify-center text-white mb-6 shadow-lg`}>
            <f.icon size={24} />
          </div>
          <h4 class="text-lg font-black text-slate-900 uppercase tracking-tighter mb-4">{f.title}</h4>
          <p class="text-slate-500 text-sm leading-relaxed font-medium">
            {f.desc}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>