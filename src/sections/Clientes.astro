---
// Aquí mapeamos tus logos reales sin romper tu estructura
const clientes = [
  { nombre: 'NAZ', logo: '/logos/naz.png' },
  { nombre: 'SEIL', logo: '/logos/seil.png' },
  { nombre: 'DMAS', logo: '/logos/dmas.png' },
  { nombre: 'PID', logo: '/logos/pid.png' },
  { nombre: 'RITTAL', logo: '/logos/rittal.png' },
  { nombre: 'WEG', logo: '/logos/weg.png' },
];
---

<section id="clientes" class="py-24 bg-white">
  <div class="container mx-auto px-6">
    <div class="flex flex-col md:flex-row justify-between items-end mb-16 gap-6">
      <div class="max-w-2xl">
        <h2 class="text-cyan-500 font-bold tracking-[0.2em] text-sm uppercase mb-4">
          Confianza Industrial
        </h2>
        <p class="text-4xl font-black text-slate-900 leading-none uppercase tracking-tighter">
          Empresas que respaldan nuestra <span class="text-[#005596]">experiencia</span>
        </p>
      </div>
      <div class="hidden md:block">
        <div class="h-1 w-24 bg-slate-100 rounded-full">
          <div class="h-1 w-12 bg-[#005596] rounded-full"></div>
        </div>
      </div>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4">
      {clientes.map((cliente) => (
        <div class="group h-32 flex items-center justify-center p-6 border border-slate-50 rounded-xl hover:bg-slate-50 transition-all duration-300">
          <div class="relative w-full h-full flex items-center justify-center">
            <span class="absolute inset-0 flex items-center justify-center text-[10px] font-bold text-slate-300 uppercase tracking-widest group-hover:opacity-0 transition-opacity">
              Logo {cliente.nombre}
            </span>
            <img 
              src={cliente.logo} 
              alt={cliente.nombre}
              class="max-h-full max-w-full grayscale opacity-40 group-hover:grayscale-0 group-hover:opacity-100 group-hover:scale-110 transition-all duration-500 ease-out relative z-10"
            />
          </div>
        </div>
      ))}
    </div>

    <div class="mt-20 grid grid-cols-1 md:grid-cols-3 gap-1 bg-[#003d6b] p-1 rounded-2xl overflow-hidden shadow-2xl shadow-blue-900/20">
      <div class="bg-[#003d6b] p-10 text-center hover:bg-[#004a82] transition-colors">
        <p class="text-4xl font-black text-white mb-1 tracking-tighter">+500</p>
        <p class="text-[10px] font-bold text-cyan-400 uppercase tracking-[0.3em]">Proyectos</p>
      </div>
      <div class="bg-[#003d6b] p-10 text-center hover:bg-[#004a82] transition-colors border-y md:border-y-0 md:border-x border-white/10">
        <p class="text-4xl font-black text-white mb-1 tracking-tighter">10</p>
        <p class="text-[10px] font-bold text-cyan-400 uppercase tracking-[0.3em]">Años de Éxito</p>
      </div>
      <div class="bg-[#003d6b] p-10 text-center hover:bg-[#004a82] transition-colors">
        <p class="text-4xl font-black text-white mb-1 tracking-tighter">100%</p>
        <p class="text-[10px] font-bold text-cyan-400 uppercase tracking-[0.3em]">Garantía</p>
      </div>
    </div>
  </div>
</section>