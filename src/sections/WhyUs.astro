---
import { CheckCircle2 } from 'lucide-react';
// Recibimos la propiedad showButton (por defecto es false)
const { showButton = false } = Astro.props;

const points = [
  "Uso de componentes originales (Siemens, ABB, Schneider).",
  "Certificación de protocolos de pruebas FAT.",
  "Ingeniería de detalle en software 3D avanzada.",
  "Cumplimiento estricto de la norma IEC 61439.",
  "Tiempos de entrega optimizados para paradas de planta."
];
---

<section id="empresa" class="py-12 bg-white">
  <div class="container mx-auto px-6">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      
      <div class="w-full text-center lg:text-left">
        <span class="text-blue-600 font-black uppercase tracking-[0.3em] text-[10px]">Diferenciación Técnica</span>
        <h3 class="text-3xl md:text-5xl font-black text-slate-900 mt-2 mb-6 uppercase tracking-tighter leading-none">
          Liderazgo en <br/><span class="text-blue-600">Ingeniería Eléctrica</span>
        </h3>
        <p class="text-slate-600 text-lg mb-8 leading-relaxed max-w-lg mx-auto lg:mx-0">
          No solo ensamblamos tableros; creamos soluciones integrales de gestión de energía, cada equipo que sale de nuestra planta pasa por un riguroso proceso de control de calidad.
        </p>
        
        <div class="space-y-3 mb-8">
          {points.map((point) => (
            <div class="flex items-center justify-center lg:justify-start gap-3">
              <div class="text-blue-600 shrink-0">
                <CheckCircle2 size={18} />
              </div>
              <span class="text-slate-800 font-bold text-sm text-left">{point}</span>
            </div>
          ))}
        </div>

        {showButton && (
          <a href="/empresa" class="inline-block bg-slate-900 text-white px-8 py-3 rounded-md font-black text-xs uppercase tracking-widest hover:bg-blue-600 transition-colors shadow-lg">
            Conoce nuestra planta
          </a>
        )}
      </div>

      <div class="relative w-full group">
        <div class="absolute -inset-0.5 bg-gradient-to-r from-blue-600 via-cyan-400 to-blue-600 rounded-[2rem] opacity-30 group-hover:opacity-75 blur transition duration-1000"></div>
        <div class="relative rounded-3xl shadow-2xl border border-slate-100 overflow-hidden bg-white">
          <img 
            src="https://i.pinimg.com/736x/28/37/8f/28378f2f7f85e14d4d90a263f0f81ec0.jpg" 
            alt="Fábrica Synapse" 
            class="w-full h-[300px] lg:h-[450px] object-cover transition-transform duration-700 group-hover:scale-105"
          />
        </div>
      </div>
    </div>
  </div>
</section>