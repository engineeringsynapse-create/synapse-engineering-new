---
import { CheckCircle2 } from 'lucide-react';

const points = [
  "Uso de componentes originales (Siemens, ABB, Schneider).",
  "Certificación de protocolos de pruebas FAT.",
  "Ingeniería de detalle en software 3D avanzada.",
  "Cumplimiento estricto de la norma IEC 61439.",
  "Tiempos de entrega optimizados para paradas de planta."
];
---

<section id="empresa" class="py-12 bg-white">
  <div class="container mx-auto px-6">
    
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      
      <div class="w-full">
        <span class="text-blue-600 font-black uppercase tracking-[0.3em] text-[10px]">Diferenciación Técnica</span>
        <h3 class="text-3xl md:text-5xl font-black text-slate-900 mt-2 mb-6 uppercase tracking-tighter leading-none">
          Liderazgo en <br/><span class="text-blue-600">Ingeniería Eléctrica</span>
        </h3>
        <p class="text-slate-600 text-lg mb-8 leading-relaxed max-w-lg">
          No solo ensamblamos tableros; creamos soluciones integrales de gestión de energía, cada equipo que sale de nuestra planta pasa por un riguroso proceso de control de calidad.
        </p>
        
        <div class="space-y-3 mb-8">
          {points.map((point) => (
            <div class="flex items-center gap-3">
              <div class="text-blue-600 shrink-0">
                <CheckCircle2 size={18} />
              </div>
              <span class="text-slate-800 font-bold text-sm">{point}</span>
            </div>
          ))}
        </div>

        <button class="bg-slate-900 text-white px-8 py-3 rounded-md font-black text-xs uppercase tracking-widest hover:bg-blue-600 transition-colors shadow-lg">
          Conoce nuestra planta
        </button>
      </div>

      <div class="w-full">
        <div class="rounded-3xl shadow-2xl overflow-hidden border border-slate-100 bg-slate-50">
          <img 
            src="https://impoexpo.com.pe/wp-content/uploads/2023/07/fabricacion-de-tableros-de-control-y-distribucion-electrica.jpg" 
            alt="Fábrica Synapse" 
            class="w-full h-auto object-cover"
          />
        </div>
      </div>

    </div>
  </div>
</section>