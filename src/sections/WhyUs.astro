---
import { CheckCircle2 } from 'lucide-react';

const points = [
  "Uso de componentes originales (Siemens, ABB, Schneider).",
  "Certificación de protocolos de pruebas FAT.",
  "Ingeniería de detalle en software 3D avanzada.",
  "Cumplimiento estricto de la norma IEC 61439.",
  "Tiempos de entrega optimizados para paradas de planta."
];
---

<section id="empresa" class="py-12 bg-white">
  <div class="container mx-auto px-6">
    
    <div class="flex flex-row items-center gap-12">
      
      <div class="w-1/2">
        <span class="text-blue-600 font-black uppercase tracking-[0.3em] text-[10px]">Diferenciación Técnica</span>
        <h3 class="text-5xl font-black text-slate-900 mt-4 mb-8 uppercase tracking-tighter leading-none">
          Liderazgo en <br/><span class="text-blue-600">Ingeniería Eléctrica</span>
        </h3>
        <p class="text-slate-600 text-lg mb-8 leading-relaxed">
          No solo ensamblamos tableros; creamos soluciones integrales de gestión de energía. Cada equipo que sale de nuestra planta pasa por un riguroso proceso de control de calidad.
        </p>
        
        <div class="space-y-4">
          {points.map((point) => (
            <div class="flex items-center gap-4">
              <div class="text-blue-600 shrink-0">
                <CheckCircle2 size={20} />
              </div>
              <span class="text-slate-800 font-bold text-sm tracking-tight">{point}</span>
            </div>
          ))}
        </div>

        <button class="mt-12 bg-slate-900 text-white px-10 py-4 rounded-md font-black text-xs uppercase tracking-widest hover:bg-blue-600 transition-colors shadow-lg">
          Conoce nuestra planta
        </button>
      </div>

      <div class="w-1/2">
        <div class="relative">
          <img 
            src="https://impoexpo.com.pe/wp-content/uploads/2023/07/fabricacion-de-tableros-de-control-y-distribucion-electrica.jpg" 
            alt="Fábrica Synapse" 
            class="rounded-3xl shadow-2xl relative z-10 w-full h-auto object-cover"
          />
          <div class="absolute -bottom-10 -left-10 w-64 h-64 bg-[#005596] rounded-3xl -z-0"></div>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  /* Forzamos que en móviles la imagen no se desborde */
  @media (max-width: 768px) {
    .container { padding: 0 1rem; }
    h3 { font-size: 1.8rem; }
    .w-1/2 { width: 100% !important; }
    .flex-row { flex-direction: column !important; }
  }
</style>