---
const brands = ["SIEMENS", "SCHNEIDER", "ABB", "EATON", "WEG", "PHOENIX CONTACT"];
---

<section class="py-12 bg-black border-y border-white/5 overflow-hidden relative flex items-center">
  <!-- Difuminado (Fade) en los extremos para un look premium -->
  <div class="absolute inset-y-0 left-0 w-24 md:w-48 bg-gradient-to-r from-black to-transparent z-10 pointer-events-none"></div>
  <div class="absolute inset-y-0 right-0 w-24 md:w-48 bg-gradient-to-l from-black to-transparent z-10 pointer-events-none"></div>

  <div class="flex whitespace-nowrap animate-marquee w-max">
    {Array(4).fill(0).map(() => (
      <div class="flex gap-16 md:gap-24 items-center px-8 md:px-12">
        {brands.map(brand => (
          <span class="text-2xl md:text-4xl font-black text-white/20 hover:text-cyan-400 transition-all duration-300 hover:scale-105 cursor-default tracking-tighter drop-shadow-sm">
            {brand}
          </span>
        ))}
      </div>
    ))}
  </div>
</section>

<style>
  @keyframes marquee {
    0% { transform: translateX(0); }
    /* Con 4 bloques en el array, el -50% garantiza un loop visual sin cortes */
    100% { transform: translateX(-50%); } 
  }
  
  .animate-marquee {
    animation: marquee 25s linear infinite;
    /* Aceleración por hardware para mayor fluidez */
    will-change: transform;
  }
  
  /* Pausamos la animación al hacer hover sobre cualquier marca */
  .animate-marquee:hover {
    animation-play-state: paused;
  }
</style>