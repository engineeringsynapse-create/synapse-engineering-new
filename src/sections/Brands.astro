---
const brands = ["SIEMENS", "SCHNEIDER", "ABB", "EATON", "WEG", "PHOENIX CONTACT"];
---

<section class="py-12 bg-black border-y border-white/5 overflow-hidden">
  <div class="flex whitespace-nowrap animate-marquee">
    {Array(3).fill(0).map(() => (
      <div class="flex gap-20 items-center px-10">
        {brands.map(brand => (
          <span class="text-2xl md:text-4xl font-black text-white/20 hover:text-primary transition-colors cursor-default tracking-tighter">
            {brand}
          </span>
        ))}
      </div>
    ))}
  </div>
</section>

<style>
  @keyframes marquee {
    0% { transform: translateX(0); }
    100% { transform: translateX(-33.33%); }
  }
  .animate-marquee {
    animation: marquee 20s linear infinite;
  }
</style>