---
import { ChevronRight, Zap } from 'lucide-react';
---

<section class="relative min-h-[90vh] flex items-center overflow-hidden bg-slate-950 pt-20">
  <!-- Contenedor del Slider -->
  <div id="hero-slider" class="absolute inset-0 z-0">
    <div class="absolute inset-0 w-full h-full bg-cover bg-center bg-no-repeat transition-opacity duration-1000 opacity-100" style="background-image: url('/fondo1.jpg');"></div>
    <div class="absolute inset-0 w-full h-full bg-cover bg-center bg-no-repeat transition-opacity duration-1000 opacity-0" style="background-image: url('/fondo2.jpg');"></div>
    <div class="absolute inset-0 w-full h-full bg-cover bg-center bg-no-repeat transition-opacity duration-1000 opacity-0" style="background-image: url('/fondo3.jpg');"></div>
  </div>
  
  <div class="absolute inset-0 z-0 bg-slate-900/60"></div>
  
  <div class="container mx-auto px-6 relative z-10">
    <div class="w-full lg:w-3/5">
      <div class="inline-flex items-center gap-2 bg-blue-600/10 border border-blue-500/20 px-4 py-2 rounded-full mb-6">
        <Zap size={14} class="text-blue-400" />
        <span class="text-blue-400 text-[10px] font-black uppercase tracking-[0.2em]">Normas Internacionales IEC 61439</span>
      </div>
      
      <h2 class="text-5xl md:text-7xl font-black text-white leading-[0.95] uppercase tracking-tighter mb-8">
        Ingeniería de <br/> <span class="text-blue-500">Potencia & Control</span>
      </h2>
      
      <p class="text-slate-400 text-lg md:text-xl max-w-2xl mb-10 leading-relaxed font-medium">
        Diseñamos y fabricamos tableros eléctricos de baja y media tensión con precisión milimétrica para la industria minera, energética y comercial en todo el Perú.
      </p>
      
      <div class="flex flex-wrap gap-4">
        <a href="#contacto" class="bg-blue-600 hover:bg-blue-700 text-white px-8 py-4 rounded-lg font-black uppercase text-xs tracking-widest transition-all shadow-lg shadow-blue-600/20 flex items-center gap-3">
          Iniciar Proyecto <ChevronRight size={16} />
        </a>
        <a href="#productos" class="bg-transparent border border-slate-700 hover:border-slate-500 text-white px-8 py-4 rounded-lg font-black uppercase text-xs tracking-widest transition-all flex items-center gap-3">
          Ver Catálogo
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  const slides = document.querySelectorAll('#hero-slider > div');
  let currentSlide = 0;

  function nextSlide() {
    slides[currentSlide].classList.replace('opacity-100', 'opacity-0');
    currentSlide = (currentSlide + 1) % slides.length;
    slides[currentSlide].classList.replace('opacity-0', 'opacity-100');
  }

  setInterval(nextSlide, 5000); // Cambia cada 5 segundos
</script>

<style>
  section { contain: layout; }
</style>