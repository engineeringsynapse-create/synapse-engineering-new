---
import { ChevronRight, ShieldCheck, Zap } from 'lucide-react';
---

<section class="relative min-h-[90vh] flex items-center overflow-hidden bg-slate-950 pt-24 pb-12">
  <div 
    class="absolute inset-0 w-full h-full z-0 opacity-40 bg-cover bg-center bg-no-repeat"
    style="background-image: url('/fondo.jpg'); background-size: cover; background-position: center center;"
  ></div>
  
  <div class="absolute inset-0 z-0 bg-slate-900/60"></div>
  
  <div class="container mx-auto px-6 relative z-10">
    <div class="flex flex-col items-start">
      
      <div class="w-full lg:w-3/5">
        <div class="inline-flex items-center gap-2 bg-blue-600/10 border border-blue-500/20 px-4 py-2 rounded-full mb-6">
          <Zap size={14} class="text-blue-400" />
          <span class="text-blue-400 text-[10px] font-black uppercase tracking-[0.2em]">Normas Internacionales IEC 61439</span>
        </div>
        
        <h2 class="text-4xl md:text-5xl lg:text-7xl font-black text-white leading-[1] uppercase tracking-tighter mb-8">
          Ingeniería de <br/> <span class="text-blue-500">Potencia & Control</span>
        </h2>
        
        <p class="text-slate-400 text-base md:text-lg lg:text-xl max-w-2xl mb-10 leading-relaxed font-medium">
          Diseñamos y fabricamos tableros eléctricos de baja y media tensión con precisión milimétrica para la industria minera, energética y comercial en todo el Perú.
        </p>
        
        <div class="flex flex-col sm:flex-row gap-4">
          <a href="#contacto" class="bg-blue-600 hover:bg-blue-700 text-white px-8 py-4 rounded-lg font-black uppercase text-xs tracking-widest transition-all shadow-lg shadow-blue-600/20 flex items-center justify-center gap-3">
            Iniciar Proyecto <ChevronRight size={16} />
          </a>
          <a href="#productos" class="bg-transparent border border-slate-700 hover:border-slate-500 text-white px-8 py-4 rounded-lg font-black uppercase text-xs tracking-widest transition-all flex items-center justify-center gap-3">
            Ver Catálogo
          </a>
        </div>

        <div class="mt-12 flex items-center gap-8 border-t border-slate-800 pt-8">
          <div class="flex flex-col">
            <span class="text-white font-black text-xl leading-none">ISO 9001</span>
            <span class="text-slate-500 text-[9px] uppercase font-bold tracking-tighter">Calidad Certificada</span>
          </div>
          <div class="w-[1px] h-8 bg-slate-800"></div>
          <div class="flex flex-col">
            <span class="text-white font-black text-xl leading-none">24/7</span>
            <span class="text-slate-500 text-[9px] uppercase font-bold tracking-tighter">Soporte Técnico</span>
          </div>
        </div>
      </div>
      
    </div>
  </div>
</section>

<style>
  section {
    contain: layout;
  }
  .bg-cover {
    image-rendering: -webkit-optimize-contrast;
    image-rendering: crisp-edges;
  }
</style>