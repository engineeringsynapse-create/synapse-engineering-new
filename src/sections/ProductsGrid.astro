---
import { ChevronRight, Cpu, Zap, Activity, ShieldCheck } from 'lucide-react';

const products = [
  {
    title: "Tableros de Distribución",
    slug: "tableros-distribucion",
    desc: "Sistemas de baja tensión con interruptores de caja moldeada y bastidor abierto.",
    icon: Zap,
    img: "https://impoexpo.com.pe/wp-content/uploads/2023/07/tableros-electricos-de-distribucion.jpg"
  },
  {
    title: "Celdas de Media Tensión",
    slug: "celdas-media-tension",
    desc: "Equipos de maniobra y protección en SF6 o aire para subestaciones.",
    icon: ShieldCheck,
    img: "https://impoexpo.com.pe/wp-content/uploads/2023/07/subestaciones-electricas.jpg"
  },
  {
    title: "Centros de Control de Motores (CCM)",
    slug: "ccm-motores",
    desc: "Arranque directo, estrella-triángulo y variadores de frecuencia centralizados.",
    icon: Activity,
    img: "https://impoexpo.com.pe/wp-content/uploads/2023/07/tablero-de-transferencia-automatica.jpg"
  },
  {
    title: "Automatización & PLC",
    slug: "automatizacion-plc",
    desc: "Programación de sistemas SCADA y control de procesos industriales.",
    icon: Cpu,
    img: "https://impoexpo.com.pe/wp-content/uploads/2023/07/tablero-empotrable-de-tapa-color-verde.jpg"
  }
];
---

<section id="productos" class="py-24 bg-slate-50 border-t border-slate-100 overflow-hidden products-section">
  <div class="container mx-auto px-6">
    <div class="flex flex-col md:flex-row justify-between items-end mb-16 gap-6">
      <div class="static-content">
        <span class="text-blue-600 font-black uppercase tracking-[0.3em] text-[10px]">Catálogo Industrial</span>
        <h3 class="text-4xl md:text-5xl font-black text-slate-900 mt-4 uppercase tracking-tighter">Soluciones Eléctricas</h3>
      </div>
      <p class="text-slate-500 max-w-md text-sm leading-relaxed static-content">
        Ingeniería aplicada a la fabricación de equipos eléctricos robustos, garantizando continuidad operativa en minería, industria y comercio.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
      {products.map((item) => (
        <div class="product-card group bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-xl border border-slate-200 transition-all duration-300">
          <div class="relative h-64 overflow-hidden">
            <img 
              src={item.img} 
              alt={item.title} 
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              loading="lazy"
              decoding="async"
            />
            <a 
              href={`/productos/${item.slug}`} 
              class="absolute inset-0 bg-gradient-to-t from-slate-900/90 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end p-6 no-underline"
            >
              <span class="text-white text-xs font-bold flex items-center gap-2 pointer-events-none">
                VER ESPECIFICACIONES <ChevronRight size={14} class="text-blue-400" />
              </span>
            </a>
          </div>
          <div class="p-8">
            <a href={`/productos/${item.slug}`} class="block mb-6 group-hover:no-underline">
              <div class="w-12 h-12 bg-blue-50 text-blue-600 rounded-xl flex items-center justify-center group-hover:bg-blue-600 group-hover:text-white transition-colors duration-300">
                <item.icon size={24} />
              </div>
            </a>
            <h4 class="font-black text-slate-900 text-lg mb-3 uppercase tracking-tight leading-tight">
              <a href={`/productos/${item.slug}`} class="hover:text-blue-600 transition-colors">
                {item.title}
              </a>
            </h4>
            <p class="text-slate-500 text-xs leading-relaxed font-medium">{item.desc}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .products-section {
    contain: layout;
    content-visibility: auto;
    contain-intrinsic-size: 1px 1000px;
  }

  .product-card {
    transform: translateZ(0);
    backface-visibility: hidden;
    will-change: transform, shadow;
  }

  .static-content {
    transform: translateZ(0);
    backface-visibility: hidden;
  }
</style>