---
import { ChevronRight, Cpu, Zap, Activity, ShieldCheck, ChevronLeft } from 'lucide-react';

const products = [
  { title: "Tableros de Distribución", slug: "tableros-distribucion", desc: "Sistemas de baja tensión con interruptores de caja moldeada y bastidor abierto.", icon: Zap, img: "https://impoexpo.com.pe/wp-content/uploads/2023/07/tableros-electricos-de-distribucion.jpg" },
  { title: "Celdas de Media Tensión", slug: "celdas-media-tension", desc: "Equipos de maniobra y protección en SF6 o aire para subestaciones.", icon: ShieldCheck, img: "https://impoexpo.com.pe/wp-content/uploads/2023/07/subestaciones-electricas.jpg" },
  { title: "Centros de Control de Motores (CCM)", slug: "ccm-motores", desc: "Arranque directo, estrella-triángulo y variadores de frecuencia centralizados.", icon: Activity, img: "https://impoexpo.com.pe/wp-content/uploads/2023/07/tablero-de-transferencia-automatica.jpg" },
  { title: "Automatización & PLC", slug: "automatizacion-plc", desc: "Programación de sistemas SCADA y control de procesos industriales.", icon: Cpu, img: "https://impoexpo.com.pe/wp-content/uploads/2023/07/tablero-empotrable-de-tapa-color-verde.jpg" }
];
---

<section id="productos" class="py-24 bg-slate-50 border-t border-slate-100 overflow-hidden products-section">
  <div class="container mx-auto px-6">
    <div class="flex flex-col md:flex-row justify-between items-end mb-8 gap-4">
      <div class="static-content">
        <span class="text-blue-600 font-black uppercase tracking-[0.3em] text-[10px]">Catálogo Industrial</span>
        <h3 class="text-4xl md:text-5xl font-black text-slate-900 mt-2 uppercase tracking-tighter">Soluciones Eléctricas</h3>
      </div>
      
      <div class="flex md:hidden gap-2 w-full justify-center mt-2">
        <button onclick="document.getElementById('slider').scrollBy({left: -document.getElementById('slider').offsetWidth, behavior: 'smooth'})" class="w-10 h-10 flex items-center justify-center bg-white border border-slate-200 rounded-full shadow-sm text-slate-900 active:bg-blue-600 active:text-white transition-all">
          <ChevronLeft size={20} />
        </button>
        <button onclick="document.getElementById('slider').scrollBy({left: document.getElementById('slider').offsetWidth, behavior: 'smooth'})" class="w-10 h-10 flex items-center justify-center bg-white border border-slate-200 rounded-full shadow-sm text-slate-900 active:bg-blue-600 active:text-white transition-all">
          <ChevronRight size={20} />
        </button>
      </div>
    </div>

    <div class="relative">
      <div id="slider" class="flex md:grid md:grid-cols-4 gap-6 overflow-x-auto scrollbar-hide no-scroll-x">
        {products.map((item) => (
          <div class="product-card group min-w-[100%] md:min-w-0 bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-xl border border-slate-200 transition-all duration-300">
            <div class="relative h-64 overflow-hidden">
              <img src={item.img} alt={item.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
              <a href={`/productos/${item.slug}`} class="absolute inset-0 bg-gradient-to-t from-slate-900/90 to-transparent opacity-0 md:group-hover:opacity-100 active:opacity-100 transition-opacity duration-300 flex items-end p-6">
                <span class="text-white text-xs font-bold flex items-center gap-2 pointer-events-none">
                  VER ESPECIFICACIONES <ChevronRight size={14} class="text-blue-400" />
                </span>
              </a>
            </div>
            <div class="p-6">
              <div class="w-10 h-10 bg-blue-50 text-blue-600 rounded-xl flex items-center justify-center mb-4">
                <item.icon size={20} />
              </div>
              <h4 class="font-black text-slate-900 text-lg mb-2 uppercase tracking-tight">{item.title}</h4>
              <p class="text-slate-500 text-xs leading-relaxed">{item.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .scrollbar-hide::-webkit-scrollbar { display: none; }
  .scrollbar-hide { -ms-overflow-style: none; scrollbar-width: none; }
  
  /* Bloqueo horizontal táctil: permite scroll vertical pero no horizontal con el dedo */
  .no-scroll-x {
    touch-action: pan-y; 
  }
  
  .products-section { contain: layout; content-visibility: auto; }
</style>