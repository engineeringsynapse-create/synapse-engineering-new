---
import { ChevronRight, ChevronLeft, Cpu, Zap, Activity, ShieldCheck } from 'lucide-react';

const products = [
  { title: "Tableros de Distribución", slug: "tableros-distribucion", desc: "Sistemas de baja tensión con interruptores de caja moldeada y bastidor abierto.", icon: Zap, img: "https://impoexpo.com.pe/wp-content/uploads/2023/07/tableros-electricos-de-distribucion.jpg" },
  { title: "Celdas de Media Tensión", slug: "celdas-media-tension", desc: "Equipos de maniobra y protección en SF6 o aire para subestaciones.", icon: ShieldCheck, img: "https://impoexpo.com.pe/wp-content/uploads/2023/07/subestaciones-electricas.jpg" },
  { title: "Centros de Control de Motores (CCM)", slug: "ccm-motores", desc: "Arranque directo, estrella-triángulo y variadores de frecuencia centralizados.", icon: Activity, img: "https://impoexpo.com.pe/wp-content/uploads/2023/07/tablero-de-transferencia-automatica.jpg" },
  { title: "Automatización & PLC", slug: "automatizacion-plc", desc: "Programación de sistemas SCADA y control de procesos industriales.", icon: Cpu, img: "https://impoexpo.com.pe/wp-content/uploads/2023/07/tablero-empotrable-de-tapa-color-verde.jpg" }
];
---

<section id="productos" class="py-24 bg-slate-50 border-t border-slate-100 overflow-hidden products-section">
  <div class="container mx-auto px-6 relative">
    
    <div class="flex flex-col md:flex-row justify-between items-end mb-16 gap-6">
      <div class="static-content">
        <span class="text-blue-600 font-black uppercase tracking-[0.3em] text-[10px]">Catálogo Industrial</span>
        <h3 class="text-4xl md:text-5xl font-black text-slate-900 mt-4 uppercase tracking-tighter">Soluciones Eléctricas</h3>
      </div>
      <p class="text-slate-500 max-w-md text-sm leading-relaxed static-content">
        Ingeniería aplicada a la fabricación de equipos eléctricos robustos, garantizando continuidad operativa en minería, industria y comercio.
      </p>
    </div>

    <div class="relative group">
      <button id="prevBtn" class="absolute left-0 top-1/2 -translate-y-1/2 z-20 bg-white/90 p-3 rounded-full shadow-lg border border-slate-200 hidden md:hidden items-center justify-center hover:bg-blue-600 hover:text-white transition-all">
        <ChevronLeft size={24} />
      </button>
      <button id="nextBtn" class="absolute right-0 top-1/2 -translate-y-1/2 z-20 bg-white/90 p-3 rounded-full shadow-lg border border-slate-200 hidden md:hidden items-center justify-center hover:bg-blue-600 hover:text-white transition-all">
        <ChevronRight size={24} />
      </button>

      <div id="productSlider" class="flex md:grid md:grid-cols-4 gap-8 overflow-x-auto snap-x snap-mandatory scroll-smooth pb-4 no-scrollbar">
        {products.map((item) => (
          <div class="product-card min-w-[85%] md:min-w-0 snap-center bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-xl border border-slate-200 transition-all duration-300">
            <div class="relative h-64 overflow-hidden">
              <img src={item.img} alt={item.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
              <a href={`/productos/${item.slug}`} class="absolute inset-0 bg-gradient-to-t from-slate-900/90 to-transparent opacity-0 hover:opacity-100 transition-opacity duration-300 flex items-end p-6 no-underline">
                <span class="text-white text-xs font-bold flex items-center gap-2">VER ESPECIFICACIONES <ChevronRight size={14} class="text-blue-400" /></span>
              </a>
            </div>
            <div class="p-8">
              <div class="w-12 h-12 bg-blue-50 text-blue-600 rounded-xl flex items-center justify-center mb-6">
                <item.icon size={24} />
              </div>
              <h4 class="font-black text-slate-900 text-lg mb-3 uppercase tracking-tight">{item.title}</h4>
              <p class="text-slate-500 text-xs leading-relaxed font-medium">{item.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  const slider = document.getElementById('productSlider') as HTMLElement;
  const prevBtn = document.getElementById('prevBtn');
  const nextBtn = document.getElementById('nextBtn');

  // Mostrar botones solo en móvil al detectar scroll
  const toggleButtons = () => {
    if (window.innerWidth < 768) {
      prevBtn?.classList.replace('hidden', 'flex');
      nextBtn?.classList.replace('hidden', 'flex');
    }
  };
  toggleButtons();

  nextBtn?.addEventListener('click', () => slider.scrollBy({ left: 300, behavior: 'smooth' }));
  prevBtn?.addEventListener('click', () => slider.scrollBy({ left: -300, behavior: 'smooth' }));
</script>

<style>
  .no-scrollbar::-webkit-scrollbar { display: none; }
  .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
</style>