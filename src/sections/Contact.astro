---
import { Phone, Mail, MapPin, Clock, Send } from 'lucide-react';
---

<section id="contacto" class="py-32 bg-white border-t border-slate-100 contact-section">
  <div class="container mx-auto px-6">
    <div class="flex flex-col lg:flex-row gap-20">
      
      <div class="w-full lg:w-1/3">
        <span class="text-blue-600 font-black uppercase tracking-[0.3em] text-[10px]">Atención Directa</span>
        <h3 class="text-4xl font-black text-slate-900 mt-4 mb-10 uppercase tracking-tighter">Hablemos de su <br/><span class="text-blue-600">Proyecto</span></h3>
        
        <div class="space-y-8">
          <div class="flex items-start gap-5 group">
            <div class="w-12 h-12 bg-blue-50 rounded-xl flex items-center justify-center text-blue-600 shrink-0 group-hover:bg-blue-600 group-hover:text-white transition-colors duration-300">
              <Phone size={20} />
            </div>
            <div>
              <p class="text-[10px] font-black text-slate-400 uppercase tracking-widest mb-1">WhatsApp de Ingeniería</p>
              <p class="text-slate-900 font-bold">+51 971 444 230</p>
            </div>
          </div>

          <div class="flex items-start gap-5 group">
            <div class="w-12 h-12 bg-blue-50 rounded-xl flex items-center justify-center text-blue-600 shrink-0 group-hover:bg-blue-600 group-hover:text-white transition-colors duration-300">
              <Mail size={20} />
            </div>
            <div>
              <p class="text-[10px] font-black text-slate-400 uppercase tracking-widest mb-1">Email de Ventas</p>
              <p class="text-slate-900 font-bold">ventas@synapse.com.pe</p>
            </div>
          </div>

          <div class="flex items-start gap-5 group">
            <div class="w-12 h-12 bg-blue-50 rounded-xl flex items-center justify-center text-blue-600 shrink-0 group-hover:bg-blue-600 group-hover:text-white transition-colors duration-300">
              <MapPin size={20} />
            </div>
            <div>
              <p class="text-[10px] font-black text-slate-400 uppercase tracking-widest mb-1">Oficina Técnica</p>
              <p class="text-slate-900 font-bold text-sm leading-tight">Calle Luis Carranza 2174, Lima</p>
            </div>
          </div>
        </div>

        <div class="mt-12 p-6 bg-slate-50 rounded-2xl border border-slate-100">
           <div class="flex items-center gap-3 text-slate-500 mb-2">
             <Clock size={16} />
             <span class="text-xs font-bold uppercase tracking-wider">Horario Laboral</span>
           </div>
           <p class="text-sm text-slate-700 font-medium">Lunes a Viernes: 08:00 AM - 06:00 PM</p>
           <p class="text-sm text-slate-700 font-medium">Sábados: 08:00 AM - 01:00 PM</p>
        </div>
      </div>

      <div class="w-full lg:w-2/3">
        <div class="bg-white p-8 md:p-10 rounded-3xl border border-slate-200 shadow-2xl shadow-slate-200/50">
          <form class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-10">
            <div class="flex flex-col gap-2">
              <label class="text-[10px] font-black text-slate-400 uppercase ml-2">Nombre</label>
              <input type="text" placeholder="Su Nombre" class="bg-slate-50 border border-slate-200 p-4 rounded-xl outline-none focus:border-blue-600 transition-colors text-sm font-bold text-slate-800" required />
            </div>
            <div class="flex flex-col gap-2">
              <label class="text-[10px] font-black text-slate-400 uppercase ml-2">Email</label>
              <input type="email" placeholder="Correo de Empresa" class="bg-slate-50 border border-slate-200 p-4 rounded-xl outline-none focus:border-blue-600 transition-colors text-sm font-bold text-slate-800" required />
            </div>
            <div class="md:col-span-2 flex flex-col gap-2">
              <label class="text-[10px] font-black text-slate-400 uppercase ml-2">Asunto</label>
              <input type="text" placeholder="Asunto / Tipo de Tablero" class="bg-slate-50 border border-slate-200 p-4 rounded-xl outline-none focus:border-blue-600 transition-colors text-sm font-bold text-slate-800" />
            </div>
            <div class="md:col-span-2 flex flex-col gap-2">
              <label class="text-[10px] font-black text-slate-400 uppercase ml-2">Mensaje</label>
              <textarea rows="4" placeholder="Describa su requerimiento..." class="bg-slate-50 border border-slate-200 p-4 rounded-xl outline-none focus:border-blue-600 transition-colors text-sm font-bold text-slate-800 resize-none"></textarea>
            </div>
            <button type="submit" class="md:col-span-2 bg-blue-600 text-white font-black py-5 rounded-xl uppercase text-xs tracking-widest flex items-center justify-center gap-3 hover:bg-slate-900 transition-all shadow-lg shadow-blue-200">
              <Send size={16} /> Solicitar Cotización Técnica
            </button>
          </form>

          <div class="w-full h-80 bg-slate-100 rounded-2xl overflow-hidden border border-slate-200 shadow-inner">
            <iframe 
              src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3901.81577782163!2d-77.0543666!3d-12.0561111!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x9105c8d000000001%3A0x6b7b2b0000000000!2sC.%20Luis%20Carranza%202174%2C%20Lima%2015082!5e0!3m2!1ses-419!2spe!4v1700000000000!5m2!1ses-419!2spe" 
              width="100%" 
              height="100%" 
              style="border:0;" 
              allowfullscreen="" 
              loading="lazy" 
              referrerpolicy="no-referrer-when-downgrade">
            </iframe>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  .contact-section {
    contain: layout;
  }
  
  /* Optimizamos los inputs para que no causen lag al escribir */
  input, textarea {
    backface-visibility: hidden;
    transform: translateZ(0);
  }
</style>