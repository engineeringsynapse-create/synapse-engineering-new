---
const steps = [
  { n: "01", title: "Ingeniería", desc: "Planificación y diagramas unifilares." },
  { n: "02", title: "Diseño 3D", desc: "Modelado estructural del gabinete." },
  { n: "03", title: "Ensamble", desc: "Montaje de componentes y cableado." },
  { n: "04", title: "FAT Tests", desc: "Pruebas de calidad y seguridad." }
];
---

<section class="py-32 bg-[#050505] relative overflow-hidden">
  <div class="container mx-auto px-6">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-12">
      {steps.map((step) => (
        <div class="reveal relative group">
          <span class="text-7xl font-black text-white/5 absolute -top-10 -left-4 group-hover:text-primary/10 transition-colors">
            {step.n}
          </span>
          <h3 class="text-xl font-bold mb-4 relative z-10">{step.title}</h3>
          <p class="text-gray-500 text-sm leading-relaxed">{step.desc}</p>
          <div class="mt-6 h-[2px] w-12 bg-primary/30 group-hover:w-full transition-all duration-700"></div>
        </div>
      ))}
    </div>
  </div>
</section>