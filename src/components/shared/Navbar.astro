---
import { Phone, Mail, MapPin, Facebook, Linkedin, Instagram, Menu, X, Bot, ShoppingCart } from 'lucide-react';

const pathname = Astro.url.pathname;

const isActive = (path: string) => {
  if (path === '/' && pathname === '/') return true;
  if (path !== '/' && pathname.startsWith(path)) return true;
  return false;
};

const activeClass = "text-blue-600";
const inactiveClass = "text-slate-700 hover:text-blue-600 transition-colors";
---

<header id="main-header" class="fixed top-0 left-0 w-full z-[1000]">
  <div id="top-bar" class="bg-[#003d6b] text-white py-2 text-[11px] font-medium hidden md:block w-full border-b border-[#004e89]">
    <div class="container mx-auto px-6 flex justify-between items-center">
      <div class="flex gap-6">
        <div class="flex items-center gap-2"><MapPin size={14} class="text-cyan-400" /> Calle Luis Carranza 2174, Lima</div>
        <div class="flex items-center gap-2"><Mail size={14} class="text-cyan-400" /> gerencia@synapse.com.pe</div>
      </div>
      <div class="flex items-center gap-4">
        <Facebook size={14} class="hover:text-cyan-400 cursor-pointer transition-colors" />
        <Linkedin size={14} class="hover:text-cyan-400 cursor-pointer transition-colors" />
        <Instagram size={14} class="hover:text-cyan-400 cursor-pointer transition-colors" />
        <button class="bg-cyan-500 hover:bg-cyan-400 text-white px-3 py-1 rounded font-black uppercase ml-4 tracking-tighter transition-colors">Brochure 2026</button>
      </div>
    </div>
  </div>

  <nav class="bg-white border-b border-slate-100 py-4 w-full shadow-sm relative">
    <div class="container mx-auto px-4 md:px-6 flex justify-between items-center">
      
      <a href="/" class="flex items-center gap-2 md:gap-3 group z-[10]">
        <div class="w-12 h-12 md:w-10 md:h-10 flex items-center justify-center rounded-lg overflow-hidden shrink-0">
          <img src="/logo.png" alt="Synapse Logo" class="w-full h-full object-contain" />
        </div>
        <div class="hidden sm:block">
          <h1 class="text-lg md:text-xl font-black text-[#005596] leading-none uppercase tracking-tighter">Synapse Engineering</h1>
          <p class="text-[8px] md:text-[9px] text-slate-500 font-bold tracking-widest uppercase">Tableros Eléctricos | Celdas | Automatización</p>
        </div>
      </a>

      <div class="flex items-center gap-2 md:gap-4 z-[1200]">
        <button id="mobile-menu-button" class="lg:hidden text-[#001529] p-2 flex items-center justify-center">
          <span class="hamburger-icon block"><Menu size={28} /></span>
          <span class="close-icon hidden"><X size={28} /></span>
        </button>
      </div>
    </div>

    <div id="mobile-menu" class="hidden absolute top-full left-0 w-full bg-white border-b border-slate-100 shadow-xl lg:hidden z-[1100]">
      <div class="flex flex-col p-6 gap-6 font-bold uppercase">
        <a href="/" class={isActive('/') ? activeClass : inactiveClass}>INICIO</a>
        <a href="/empresa" class={isActive('/empresa') ? activeClass : inactiveClass}>LA EMPRESA</a>
        <a href="/productos" class={isActive('/productos') ? activeClass : inactiveClass}>PRODUCTOS</a>
        <a href="/disenos" class={isActive('/disenos') ? activeClass : inactiveClass}>DISEÑOS</a>
        <a href="/clientes" class={isActive('/clientes') ? activeClass : inactiveClass}>CLIENTES</a>
        <a href="/contacto" class={isActive('/contacto') ? activeClass : inactiveClass}>CONTACTO</a>
        <a href="/tienda" class={isActive('/tienda') ? activeClass : inactiveClass}>TIENDA</a>
        <a href="/soporte-ia" class="text-cyan-600">SOPORTE IA</a>
        <hr class="border-slate-100" />
        <a href="https://wa.me/51971444230" class="text-blue-600">WhatsApp: 971 444 230</a>
      </div>
    </div>
  </nav>
</header>