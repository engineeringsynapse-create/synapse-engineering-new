---
import { Phone, Mail, MapPin, Facebook, Linkedin, Instagram, Youtube, MessageCircle, Menu, X, Bot, ShoppingCart } from 'lucide-react';
// Importamos el icono para TikTok (Music es el estándar en Lucide para esta red social)
import { Music } from 'lucide-react'; 

const pathname = Astro.url.pathname;

const isActive = (path: string) => {
  if (path === '/' && pathname === '/') return true;
  if (path !== '/' && pathname.startsWith(path)) return true;
  return false;
};

const activeClass = "text-blue-600";
const inactiveClass = "text-slate-700 hover:text-blue-600 transition-colors";
---

<header id="main-header" class="fixed top-0 left-0 w-full z-[1000]">
  <div id="top-bar" class="bg-[#003d6b] text-white py-1.5 text-[10px] w-full border-b border-[#004e89] flex">
    <div class="container mx-auto px-4 flex justify-between items-center">
      <div class="flex items-center gap-1.5 whitespace-nowrap">
        <MapPin size={14} class="text-cyan-400 shrink-0" /> Lima
      </div>
      
      <div class="flex items-center gap-3 ml-auto">
        <a href="mailto:gerencia@synapse.com.pe" class="hover:text-cyan-400 transition-colors"><Mail size={14} /></a>
        <a href="https://wa.me/51971444230" target="_blank" class="hover:text-cyan-400 transition-colors"><MessageCircle size={14} /></a>
        <a href="#" class="hover:text-cyan-400 transition-colors"><Facebook size={14} /></a>
        <a href="#" class="hover:text-cyan-400 transition-colors"><Linkedin size={14} /></a>
        <a href="#" class="hover:text-cyan-400 transition-colors"><Instagram size={14} /></a>
        <a href="#" class="hover:text-cyan-400 transition-colors"><Youtube size={14} /></a>
        <a href="#" class="hover:text-cyan-400 transition-colors"><Music size={14} /></a>
        
        <button class="bg-cyan-500 hover:bg-cyan-400 text-white px-2 py-0.5 rounded font-black uppercase text-[9px] tracking-tighter transition-colors ml-2">
          Brochure
        </button>
      </div>
    </div>
  </div>

  <nav class="bg-white border-b border-slate-100 py-4 w-full shadow-sm relative">
    <div class="container mx-auto px-4 md:px-6 flex justify-between items-center">
      <a href="/" class="flex items-center gap-2 md:gap-3 group justify-start">
        <div class="w-12 h-12 md:w-10 md:h-10 flex items-center justify-center rounded-lg overflow-hidden shrink-0">
          <img src="/logo.png" alt="Synapse Logo" class="w-full h-full object-contain" />
        </div>
        <div>
          <h1 class="text-lg md:text-xl font-black text-[#005596] leading-none uppercase tracking-tighter">
            Synapse Engineering
          </h1>
          <p class="text-[8px] md:text-[9px] text-slate-500 font-bold tracking-widest uppercase">
            Tableros Eléctricos | Celdas | Automatización
          </p>
        </div>
      </a>

      <div class="hidden lg:flex items-center gap-8 text-[13px] font-bold uppercase">
        <a href="/" class={isActive('/') ? activeClass : inactiveClass}>INICIO</a>
        <a href="/empresa" class={isActive('/empresa') ? activeClass : inactiveClass}>LA EMPRESA</a>
        <a href="/productos" class={isActive('/productos') ? activeClass : inactiveClass}>PRODUCTOS</a>
        <a href="/disenos" class={isActive('/disenos') ? activeClass : inactiveClass}>DISEÑOS</a>
        <a href="/clientes" class={isActive('/clientes') ? activeClass : inactiveClass}>CLIENTES</a>
        <a href="/contacto" class={isActive('/contacto') ? activeClass : inactiveClass}>CONTACTO</a>
        <a href="/tienda" class={isActive('/tienda') ? activeClass : inactiveClass}>TIENDA</a>
        
        <a href="/soporte-ia" class={isActive('/soporte-ia') ? "text-cyan-500 flex items-center gap-2" : "text-slate-700 hover:text-cyan-500 transition-colors flex items-center gap-2"}>
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-cyan-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-cyan-300"></span>
          </span>
          SOPORTE IA
        </a>

        <a href="/tienda/carrito" class="relative text-slate-700 hover:text-blue-600 transition-colors">
          <ShoppingCart size={20} />
          <span id="cart-count" class="absolute -top-2 -right-2 bg-blue-600 text-white text-[9px] font-black rounded-full h-4 w-4 flex items-center justify-center hidden">0</span>
        </a>
      </div>

      <div class="flex items-center gap-2 md:gap-4">
        <a href="https://wa.me/51971444230" target="_blank" class="hidden sm:flex items-center gap-3 bg-slate-50 p-2 rounded-full pr-6 border border-slate-100 hover:shadow-md transition-all">
          <div class="w-10 h-10 bg-blue-600 rounded-full flex items-center justify-center text-white">
            <Phone size={18} />
          </div>
          <div class="leading-none">
            <p class="text-[10px] text-slate-400 font-bold uppercase">WhatsApp</p>
            <p class="text-sm font-black text-slate-800">971 444 230</p>
          </div>
        </a>
        
        <button id="mobile-menu-button" class="lg:hidden text-[#001529] focus:outline-none p-2 flex items-center justify-center relative z-[1100]">
          <span class="hamburger-icon block"><Menu size={28} /></span>
          <span class="close-icon hidden"><X size={28} /></span>
        </button>
      </div>
    </div>
    </nav>
</header>